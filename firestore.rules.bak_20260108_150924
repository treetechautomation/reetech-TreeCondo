rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return signedIn() && (
        request.auth.token.superAdmin == true ||
        request.auth.token.email == "treecommunity@treetechautomation.com"
      );
    }

    function memberDoc(condId) {
      return get(/databases/$(database)/documents/condominios/$(condId)/membros/$(request.auth.uid));
    }

    function isMember(condId) {
      return request.auth != null
        && exists(/databases/$(database)/documents/condominios/$(condId)/membros/$(request.auth.uid));
    }

    function isActiveMember(condId) {
      return isMember(condId) && memberDoc(condId).data.status == "ATIVO";
    }

    function memberRole(condId) {
      return isMember(condId) ? (memberDoc(condId).data.role) : null;
    }

    function hasMenu(condId, key) {
      return isMember(condId)
        && (memberDoc(condId).data.menuPermissions[key] == true);
    }
// Condomínios
    match /condominios/{condId} {
      
      match /anuncios/{anuncioId} {
        allow read: if isSuperAdmin() || isActiveMember(condId);
        allow create, update, delete: if isSuperAdmin()
          || (isActiveMember(condId)
              && memberRole(condId) != "MORADOR"
              && hasMenu(condId, "anuncios"));
      }

// super admin lê tudo
      allow read: if isSuperAdmin() || isMember(condId);

      // criar/editar condomínio: só super admin
      allow create, update, delete: if isSuperAdmin();

      // Subcoleções do condomínio
      match /{sub=**} {
        allow read: if isSuperAdmin() || isMember(condId);
        allow write: if isSuperAdmin(); // ajuste depois por role (síndico/admin)
      }
    }

    // fallback: nega tudo
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
