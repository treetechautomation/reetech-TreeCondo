    "ManutencaoRotina": {
      "title": "Rotina de Manutenção",
      "description": "Uma rotina de manutenção preventiva recorrente.",
      "type": "object",
      "properties": {
        "titulo": { "type": "string", "description": "Título da rotina de manutenção." },
        "categoria": { "type": "string", "enum": ["DEDETIZACAO", "CAIXA_DAGUA", "ELEVADOR", "EXTINTORES", "OUTROS"], "description": "Categoria da manutenção." },
        "descricao": { "type": "string", "description": "Descrição detalhada da manutenção." },
        "recorrenciaTipo": { "type": "string", "enum": ["SEMANAL", "MENSAL", "TRIMESTRAL", "SEMESTRAL", "ANUAL", "CUSTOM"], "description": "Tipo de recorrência." },
        "recorrenciaIntervalo": { "type": "number", "description": "Intervalo da recorrência (ex: 6 para semestral)." },
        "diaPreferencial": { "type": ["number", "null"], "description": "Dia do mês preferencial para execução." },
        "dataInicio": { "type": "string", "format": "date-time", "description": "Data de início da rotina." },
        "proximaExecucaoEm": { "type": "string", "format": "date-time", "description": "Data da próxima execução calculada." },
        "alertasDiasAntes": { "type": "array", "items": { "type": "number" }, "description": "Dias antes da próxima execução para enviar alertas." },
        "status": { "type": "string", "enum": ["ATIVA", "PAUSADA", "ENCERRADA"], "description": "Status da rotina." },
        "fornecedorId": { "type": ["string", "null"], "description": "ID do fornecedor associado." },
        "responsavel": { "type": "string", "enum": ["SINDICO", "ZELADOR", "TERCEIRO"], "description": "Responsável pela execução." },
        "createdByUid": { "type": "string", "description": "UID do usuário que criou a rotina." },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["titulo", "categoria", "recorrenciaTipo", "dataInicio", "proximaExecucaoEm", "status", "createdByUid"]
    },
    "ManutencaoExecucao": {
      "title": "Execução de Manutenção",
      "description": "Registro de uma execução de uma rotina de manutenção.",
      "type": "object",
      "properties": {
        "rotinaId": { "type": "string", "description": "ID da rotina de manutenção pai." },
        "titulo": { "type": "string", "description": "Título da rotina (cache)." },
        "categoria": { "type": "string", "description": "Categoria da rotina (cache)." },
        "dataProgramada": { "type": "string", "format": "date-time" },
        "dataConcluida": { "type": ["string", "null"], "format": "date-time" },
        "status": { "type": "string", "enum": ["PROGRAMADA", "ALERTA_30", "ALERTA_15", "ALERTA_7", "CONCLUIDA", "ATRASADA", "CANCELADA"] },
        "checklist": { "type": "array", "items": { "type": "string" } },
        "notas": { "type": "string", "description": "Observações sobre a execução." },
        "criadoPorUid": { "type": "string" },
        "criadoPorNome": { "type": "string" },
        "fornecedorId": { "type": ["string", "null"], "description": "ID do fornecedor (cache)." },
        "fornecedorNome": { "type": ["string", "null"], "description": "Nome do fornecedor (cache)." },
        "anexos": { "type": "array", "items": {
            "type": "object",
            "properties": {
                "url": { "type": "string" },
                "name": { "type": "string" },
                "type": { "type": "string" }
            }
        }},
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["rotinaId", "dataProgramada", "status"]
    },
    "Anuncio": { "title": "Anuncio", "type": "object", "properties": { "title": { "type": "string" } } },
    "Reserva": { "title": "Reserva", "type": "object", "properties": { "area": { "type": "string" } } },
    "Reuniao": { "title": "Reuniao", "type": "object", "properties": { "title": { "type": "string" } } },
    "Incidente": { "title": "Incidente", "type": "object", "properties": { "description": { "type": "string" } } },
    "Encomenda": { "title": "Encomenda", "type": "object", "properties": { "trackingCode": { "type": "string" } } },
    "Documento": { "title": "Documento", "type": "object", "properties": { "fileName": { "type": "string" } } },
    "Enquete": { "title": "Enquete", "type": "object", "properties": { "question": { "type": "string" } } }
  },
  "auth": {
    "providers": ["password", "anonymous"],
    "customClaims": ["super_admin"]
  },
  "firestore": {
    "structure": [
      {
        "path": "/condominios/{condominioId}",
        "definition": {
          "entityName": "Condominio",
          "schema": { "$ref": "#/entities/Condominio" },
          "description": "Coleção principal que armazena cada condomínio."
        }
      },
      {
        "path": "/condominios/{condominioId}/blocos/{blocoId}",
        "definition": {
          "entityName": "Bloco",
          "schema": { "$ref": "#/entities/Bloco" },
          "description": "Sub-coleção para organizar as unidades em blocos/torres."
        }
      },
      {
        "path": "/condominios/{condominioId}/blocos/{blocoId}/unidades/{unidadeId}",
        "definition": {
          "entityName": "Unidade",
