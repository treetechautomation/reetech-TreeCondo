              "createdAt": "2024-07-30T11:10:00Z"
            }
          }
        }
      ]
    },
    "Membro": {
      "title": "Membro",
      "description": "Representa um membro administrativo do condomínio, como Síndico ou Porteiro. O ID do documento é o UID do Firebase Auth.",
      "type": "object",
      "properties": {
        "role": { "type": "string", "enum": ["SUPER_ADMIN", "ADMIN_CONDOMINIO", "SINDICO", "SUB_SINDICO", "PORTEIRO", "FUNCIONARIO"] },
        "status": { "type": "string", "enum": ["ATIVO", "INATIVO", "PENDENTE"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "createdBy": { "type": "string", "description": "UID de quem criou o membro." },
        "escopo": {
          "type": "object",
          "description": "Define o escopo de atuação do membro.",
          "properties": {
            "type": { "type": "string", "enum": ["GLOBAL", "CONDOMINIO", "BLOCO"] },
            "condominioId": { "type": "string", "description": "ID do condomínio, se o escopo for CONDOMINIO ou BLOCO." },
            "blocoId": { "type": "string", "description": "ID do bloco, se o escopo for BLOCO." }
          }
        }
      },
      "required": ["role", "status", "createdAt", "createdBy"],
      "examples": [
        {
          "title": "Admin do Condomínio",
          "id": "UID_ADMIN",
          "value": {
            "role": "ADMIN_CONDOMINIO",
            "status": "ATIVO",
            "createdAt": "2024-07-31T10:00:00Z",
            "createdBy": "SUPER_ADMIN_UID",
            "escopo": {
              "type": "CONDOMINIO",
              "condominioId": "chacara-itaguai"
            }
          }
        },
        {
          "title": "Síndico do Bloco Dálias",
          "id": "UID_SINDICO_DALIAS",
          "value": {
            "role": "SINDICO",
            "status": "ATIVO",
            "createdAt": "2024-07-31T10:01:00Z",
            "createdBy": "UID_ADMIN",
            "escopo": {
              "type": "BLOCO",
              "condominioId": "chacara-itaguai",
              "blocoId": "dalias"
            }
          }
        },
        {
          "title": "Síndico do Bloco Rosas",
          "id": "UID_SINDICO_ROSAS",
          "value": {
            "role": "SINDICO",
            "status": "ATIVO",
            "createdAt": "2024-07-31T10:02:00Z",
            "createdBy": "UID_ADMIN",
            "escopo": {
              "type": "BLOCO",
              "condominioId": "chacara-itaguai",
              "blocoId": "rosas"
            }
          }
        }
      ]
    },
    "Funcionario": {
      "title": "Funcionario",
      "description": "Representa um funcionário contratado pelo condomínio.",
      "type": "object",
      "properties": {
        "nome": { "type": "string" },
        "cargo": { "type": "string", "enum": ["PORTEIRO", "ZELADOR", "FAXINEIRO"] },
        "horario": { "type": "string", "description": "Descrição do turno de trabalho." },
        "contato": { "type": "string" },
        "status": { "type": "string", "enum": ["ATIVO", "FERIAS", "INATIVO"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "createdBy": { "type": "string", "description": "UID de quem cadastrou o funcionário." }
      },
      "required": ["nome", "cargo", "status", "createdAt"]
    },
    "Fornecedor": {
      "title": "Fornecedor",
      "description": "Representa uma empresa ou pessoa que presta serviços para o condomínio.",
      "type": "object",
      "properties": {
        "nome": { "type": "string" },
        "servico": { "type": "string", "description": "Descrição do serviço prestado (ex: jardinagem, manutenção de elevador)." },
        "contato": { "type": "string" },
        "ativo": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "createdBy": { "type": "string", "description": "UID de quem cadastrou o fornecedor." }
      },
      "required": ["nome", "servico", "ativo", "createdAt"]
    },
    "Veiculo": {
      "title": "Veiculo",
      "description": "Representa um veículo pertencente a uma unidade.",
      "type": "object",
      "properties": {
        "placa": { "type": "string" },
        "modelo": { "type": "string" },
        "cor": { "type": "string" },
        "tipo": { "type": "string", "enum": ["CARRO", "MOTO"] },
        "ownerUid": { "type": "string", "description": "UID do morador proprietário do veículo." },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["placa", "modelo", "tipo", "ownerUid", "createdAt"]
    },
    "Pet": {
      "title": "Pet",
      "description": "Representa um animal de estimação de uma unidade.",
      "type": "object",
      "properties": {
        "nome": { "type": "string" },
        "raca": { "type": "string" },
        "porte": { "type": "string", "enum": ["PEQUENO", "MEDIO", "GRANDE"] },
        "ownerUid": { "type": "string", "description": "UID do morador proprietário do pet." },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["nome", "raca", "porte", "ownerUid", "createdAt"]
    },
    "VinculoUsuario": {
      "title": "VinculoUsuario",
      "description": "Índice de acesso rápido que associa um usuário a um ou mais condomínios e suas respectivas permissões/vínculos.",
      "type": "object",
      "properties": {
        "condominioId": { "type": "string" },
        "condominioNome": { "type": "string" },
        "role": { "type": "string", "enum": ["SUPER_ADMIN", "ADMIN_CONDOMINIO", "SINDICO", "SUB_SINDICO", "MORADOR", "PORTEIRO", "FUNCIONARIO"] },
        "status": { "type": "string", "enum": ["ATIVO", "INATIVO", "PENDENTE"] },
        "blocoId": { "type": "string", "description": "ID do bloco, obrigatório se role='MORADOR'." },
        "unidadeId": { "type": "string", "description": "ID da unidade, obrigatório se role='MORADOR'." }
      },
      "required": ["condominioId", "condominioNome", "role", "status"],
      "examples": [
        {
          "title": "Vínculo de Morador",
          "value": {
            "id": "condominio_xyz",
            "data": {
              "condominioId": "condominio_xyz",
              "condominioNome": "Condomínio Vila das Flores",
              "role": "MORADOR",
              "status": "ATIVO",
              "blocoId": "bloco_a",
              "unidadeId": "unidade_101"
            }
          }
        },
        {
          "title": "Vínculo de Síndico",
          "value": {
            "id": "condominio_xyz",
            "data": {
              "condominioId": "condominio_xyz",
              "condominioNome": "Condomínio Vila das Flores",
              "role": "SINDICO",
              "status": "ATIVO"
            }
          }
        },
        {
          "title": "Vínculo de Porteiro",
          "value": {
            "id": "condominio_abc",
            "data": {
              "condominioId": "condominio_abc",
              "condominioNome": "Residencial Bosque Verde",
              "role": "PORTEIRO",
              "status": "ATIVO"
            }
          }
        }
      ]
    },
    "Ramal": {
      "title": "Ramal",
      "description": "Representa um ramal telefônico de uma área comum dentro de um bloco.",
      "type": "object",
      "properties": {
        "nome": { "type": "string", "description": "Nome da área comum (Ex: 'Academia', 'Portaria')." },
        "numero": { "type": "string", "description": "Número do ramal." },
        "ativo": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["nome", "numero", "ativo", "createdAt"],
      "examples": [
        {
          "title": "Ramais Bloco Dálias",
          "value": [
            { "id": "SALA_DE_ADMINISTRACAO", "data": { "nome": "Sala de Administração", "numero": "94", "ativo": true, "createdAt": "2024-07-31T12:00:00Z" } },
            { "id": "PORTARIA", "data": { "nome": "Portaria", "numero": "92", "ativo": true, "createdAt": "2024-07-31T12:01:00Z" } },
            { "id": "ACADEMIA", "data": { "nome": "Academia", "numero": "90", "ativo": true, "createdAt": "2024-07-31T12:02:00Z" } }
          ]
        },
        {
          "title": "Ramais Bloco Rosas",
          "value": [
            { "id": "SALA_DE_ADMINISTRACAO", "data": { "nome": "Sala de Administração", "numero": "84", "ativo": true, "createdAt": "2024-07-31T12:03:00Z" } },
            { "id": "PORTARIA", "data": { "nome": "Portaria", "numero": "82", "ativo": true, "createdAt": "2024-07-31T12:04:00Z" } },
            { "id": "ACADEMIA", "data": { "nome": "Academia", "numero": "80", "ativo": true, "createdAt": "2024-07-31T12:05:00Z" } }
          ]
        }
      ]
    },
    "Anuncio": { "title": "Anuncio", "type": "object", "properties": { "title": { "type": "string" } } },
    "Reserva": { "title": "Reserva", "type": "object", "properties": { "area": { "type": "string" } } },
    "Reuniao": { "title": "Reuniao", "type": "object", "properties": { "title": { "type": "string" } } },
    "Incidente": { "title": "Incidente", "type": "object", "properties": { "description": { "type": "string" } } },
    "Encomenda": { "title": "Encomenda", "type": "object", "properties": { "trackingCode": { "type": "string" } } },
    "Documento": { "title": "Documento", "type": "object", "properties": { "fileName": { "type": "string" } } },
    "Enquete": { "title": "Enquete", "type": "object", "properties": { "question": { "type": "string" } } }
  },
  "auth": {
    "providers": ["password", "anonymous"],
    "customClaims": ["super_admin"]
  },
  "firestore": {
    "structure": [
      {
        "path": "/condominios/{condominioId}",
        "definition": {
          "entityName": "Condominio",
          "schema": { "$ref": "#/entities/Condominio" },
          "description": "Coleção principal que armazena cada condomínio."
        }
      },
      {
        "path": "/condominios/{condominioId}/blocos/{blocoId}",
        "definition": {
          "entityName": "Bloco",
          "schema": { "$ref": "#/entities/Bloco" },
          "description": "Sub-coleção para organizar as unidades em blocos/torres."
        }
      },
      {
        "path": "/condominios/{condominioId}/blocos/{blocoId}/unidades/{unidadeId}",
        "definition": {
          "entityName": "Unidade",
          "schema": { "$ref": "#/entities/Unidade" },
          "description": "Sub-coleção para as unidades de um bloco."
        }
      },
      {
        "path": "/condominios/{condominioId}/blocos/{blocoId}/unidades/{unidadeId}/moradores/{uid}",
        "definition": {
          "entityName": "Morador",
          "schema": { "$ref": "#/entities/Morador" },
          "description": "Sub-coleção de moradores da unidade. O ID do documento é o UID do Firebase Auth."
        }
      },
      {
        "path": "/condominios/{condominioId}/blocos/{blocoId}/unidades/{unidadeId}/veiculos/{veiculoId}",
        "definition": {
          "entityName": "Veiculo",
          "schema": { "$ref": "#/entities/Veiculo" },
          "description": "Veículos associados a uma unidade."
        }
      },
      {
        "path": "/condominios/{condominioId}/blocos/{blocoId}/unidades/{unidadeId}/pets/{petId}",
        "definition": {
          "entityName": "Pet",
          "schema": { "$ref": "#/entities/Pet" },
          "description": "Pets associados a uma unidade."
        }
      },
      {
        "path": "/condominios/{condominioId}/blocos/{blocoId}/ramais/{ramalId}",
        "definition": {
          "entityName": "Ramal",
          "schema": { "$ref": "#/entities/Ramal" },
          "description": "Ramais de áreas comuns de um bloco."
        }
      },
      {
        "path": "/condominios/{condominioId}/membros/{uid}",
        "definition": {
          "entityName": "Membro",
          "schema": { "$ref": "#/entities/Membro" },
          "description": "Membros administrativos do condomínio (ex: síndico, porteiro). O ID do documento é o UID do usuário no Firebase Auth."
        }
      },
      {
        "path": "/condominios/{condominioId}/funcionarios/{funcionarioId}",
        "definition": {
          "entityName": "Funcionario",
          "schema": { "$ref": "#/entities/Funcionario" },
          "description": "Funcionários contratados do condomínio."
        }
      },
      {
        "path": "/condominios/{condominioId}/fornecedores/{fornecedorId}",
        "definition": {
          "entityName": "Fornecedor",
          "schema": { "$ref": "#/entities/Fornecedor" },
          "description": "Fornecedores de serviços para o condomínio."
        }
      },
       {
        "path": "/userCondominios/{uid}/vinculos/{condominioId}",
        "definition": {
          "entityName": "VinculoUsuario",
          "schema": { "$ref": "#/entities/VinculoUsuario" },
          "description": "Índice para acesso rápido aos condomínios e permissões de um usuário."
        }
      },
      { "path": "/condominios/{condominioId}/anuncios/{anuncioId}", "definition": { "schema": { "$ref": "#/entities/Anuncio" }, "description": "Anúncios do condomínio." } },
      { "path": "/condominios/{condominioId}/reservas/{reservaId}", "definition": { "schema": { "$ref": "#/entities/Reserva" }, "description": "Reservas de áreas comuns." } },
      { "path": "/condominios/{condominioId}/reunioes/{reuniaoId}", "definition": { "schema": { "$ref": "#/entities/Reuniao" }, "description": "Reuniões e assembleias." } },
      { "path": "/condominios/{condominioId}/incidentes/{incidenteId}", "definition": { "schema": { "$ref": "#/entities/Incidente" }, "description": "Incidentes e chamados." } },
      { "path": "/condominios/{condominioId}/encomendas/{encomendaId}", "definition": { "schema": { "$ref": "#/entities/Encomenda" }, "description": "Encomendas recebidas." } },
      { "path": "/condominios/{condominioId}/documentos/{documentoId}", "definition": { "schema": { "$ref": "#/entities/Documento" }, "description": "Documentos gerais." } },
      { "path": "/condominios/{condominioId}/enquetes/{enqueteId}", "definition": { "schema": { "$ref": "#/entities/Enquete" }, "description": "Enquetes e votações." } }
    ],
    "queries": [
      {
        "description": "Listar todos os condomínios (Apenas Super Admin).",
        "query": "firestore.collection('condominios').get()"
      }
    ]
  }
}
