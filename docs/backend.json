    },
    "Membro": {
      "title": "Membro",
      "description": "Representa um membro administrativo do condomínio (ex: Síndico). O ID do documento é o UID do Firebase Auth. Esta é a fonte da verdade para permissões de staff.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "UID do usuário. Deve ser igual ao ID do documento." },
        "role": { "type": "string", "enum": ["SUPER_ADMIN", "ADMIN_CONDOMINIO", "SINDICO", "SUB_SINDICO", "PORTEIRO", "FUNCIONARIO"] },
        "ativo": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "createdBy": { "type": "string", "description": "UID de quem criou o membro." },
        "scope": {
          "type": "object",
          "description": "Define o escopo de atuação do membro.",
          "properties": {
            "type": { "type": "string", "enum": ["GLOBAL", "CONDOMINIO", "BLOCO"], "description": "Nível de acesso." },
            "condominioId": { "type": "string", "description": "Obrigatório se type for CONDOMINIO ou BLOCO." },
            "blocoId": { "type": "string", "description": "Obrigatório se type for BLOCO." }
          }
        }
      },
      "required": ["uid", "role", "ativo", "scope", "createdAt"],
      "examples": [
        {
          "title": "Admin do Condomínio",
          "id": "UID_ADMIN",
          "value": {
            "uid": "UID_ADMIN",
            "role": "ADMIN_CONDOMINIO",
            "ativo": true,
            "createdAt": "2024-07-31T10:00:00Z",
            "createdBy": "p0XWt3ed7VgiEjHoItfmNq31cT62",
            "scope": {
              "type": "CONDOMINIO",
              "condominioId": "chacara-itaguai"
            }
          }
        },
        {
          "title": "Síndico do Bloco Dálias",
          "id": "UID_SINDICO_DALIAS",
