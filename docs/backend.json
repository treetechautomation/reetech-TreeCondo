
{
  "entities": {
    "Condominio": {
      "title": "Condominio",
      "description": "Representa um único condomínio. Contém todas as suas sub-coleções de dados.",
      "type": "object",
      "properties": {
        "nome": { "type": "string", "description": "Nome do condomínio." },
        "cnpj": { "type": "string", "description": "CNPJ do condomínio." },
        "cep": { "type": "string", "description": "CEP do endereço do condomínio." },
        "ativo": { "type": "boolean", "description": "Indica se o condomínio está ativo na plataforma." },
        "createdAt": { "type": "string", "format": "date-time", "description": "Data de criação do registro." },
        "createdBy": { "type": "string", "description": "UID do super_admin que criou o condomínio." }
      },
      "required": ["nome", "ativo", "createdAt", "createdBy"]
    },
    "Bloco": {
        "title": "Bloco",
        "description": "Representa um bloco, torre ou setor dentro de um condomínio.",
        "type": "object",
        "properties": {
            "nome": { "type": "string", "description": "Nome ou identificador do bloco (Ex: 'Bloco A', 'Torre 1')." }
        },
        "required": ["nome"]
    },
    "Unidade": {
        "title": "Unidade",
        "description": "Representa uma unidade individual (apartamento, casa) dentro de um bloco.",
        "type": "object",
        "properties": {
            "numero": { "type": "string", "description": "Número ou identificador da unidade (Ex: '101', 'Casa 23')." }
        },
        "required": ["numero"]
    },
    "Morador": {
        "title": "Morador",
        "description": "Representa um morador associado a uma unidade específica.",
        "type": "object",
        "properties": {
            "nome": { "type": "string" },
            "email": { "type": "string", "format": "email" },
            "isResponsavel": { "type": "boolean", "description": "Indica se é o morador principal/responsável pela unidade." }
        },
        "required": ["nome", "isResponsavel"]
    },
    "MembroCondominio": {
      "title": "Membro do Condomínio",
      "description": "Define o papel de um usuário (não-morador) dentro de um condomínio (ex: síndico, porteiro).",
      "type": "object",
      "properties": {
        "role": { "type": "string", "enum": ["sindico", "porteiro"], "description": "Papel do usuário neste condomínio." },
        "status": { "type": "string", "enum": ["ativo", "inativo"], "description": "Status do vínculo do usuário com o condomínio." },
        "createdAt": { "type": "string", "format": "date-time" },
        "createdBy": { "type": "string", "description": "UID de quem adicionou o membro." }
      },
      "required": ["role", "status", "createdAt", "createdBy"]
    },
    "ConfigMenu": {
        "title": "Configuração de Menu",
        "description": "Define as permissões de acesso aos módulos do menu para cada papel (role) dentro de um condomínio.",
        "type": "object",
        "properties": {
            "sindico": { "$ref": "#/entities/PermissoesMenu" },
            "morador": { "$ref": "#/entities/PermissoesMenu" },
            "porteiro": { "$ref": "#/entities/PermissoesMenu" }
        }
    },
    "PermissoesMenu": {
        "title": "Permissões de Módulo",
        "description": "Mapa booleano que indica a visibilidade de cada módulo do sistema.",
        "type": "object",
        "properties": {
            "anuncios": { "type": "boolean" },
            "reservas": { "type": "boolean" },
            "reunioes": { "type": "boolean" },
            "incidentes": { "type": "boolean" },
            "encomendas": { "type": "boolean" },
            "documentos": { "type": "boolean" },
            "enquetes": { "type": "boolean" },
            "acesso": { "type": "boolean" },
            "cadastros": { "type": "boolean" }
        }
    },
    "VinculoUsuario": {
        "title": "Vínculo do Usuário com Condomínio",
        "description": "Documento de índice que espelha o vínculo de um usuário a um condomínio para consultas rápidas.",
        "type": "object",
        "properties": {
            "condominioId": { "type": "string" },
            "condominioNome": { "type": "string" },
            "role": { "type": "string", "enum": ["sindico", "morador", "porteiro"] },
            "status": { "type": "string", "enum": ["ativo", "inativo", "pendente"] },
            "blocoId": { "type": "string", "description": "ID do bloco, se o papel for 'morador'." },
            "unidadeId": { "type": "string", "description": "ID da unidade, se o papel for 'morador'." }
        },
        "required": ["condominioId", "condominioNome", "role", "status"]
    },
    "Anuncio": { "title": "Anuncio", "type": "object", "properties": { "title": { "type": "string" }}},
    "Reserva": { "title": "Reserva", "type": "object", "properties": { "area": { "type": "string" }}},
    "Reuniao": { "title": "Reuniao", "type": "object", "properties": { "title": { "type": "string" }}},
    "Incidente": { "title": "Incidente", "type": "object", "properties": { "description": { "type": "string" }}},
    "Encomenda": { "title": "Encomenda", "type": "object", "properties": { "trackingCode": { "type": "string" }}},
    "Documento": { "title": "Documento", "type": "object", "properties": { "fileName": { "type": "string" }}},
    "Enquete": { "title": "Enquete", "type": "object", "properties": { "question": { "type": "string" }}},
    "Acesso": { "title": "Acesso", "type": "object", "properties": { "visitorName": { "type": "string" }}},
    "Cadastro": { "title": "Cadastro", "type": "object", "properties": { "type": { "type": "string" }}}
  },
  "auth": {
    "providers": ["password", "anonymous"],
    "customClaims": ["super_admin"]
  },
  "firestore": {
    "structure": [
      {
        "path": "/condominios/{condominioId}",
        "definition": {
          "entityName": "Condominio",
          "schema": { "$ref": "#/entities/Condominio" },
          "description": "Coleção principal que armazena cada condomínio. Acesso de escrita restrito a super_admins."
        }
      },
      {
        "path": "/condominios/{condominioId}/membros/{uid}",
        "definition": {
            "entityName": "MembroCondominio",
            "schema": { "$ref": "#/entities/MembroCondominio" },
            "description": "Sub-coleção que mapeia um UID de usuário a seu papel (síndico, porteiro) e status. Controla o acesso de não-moradores."
        }
      },
      {
        "path": "/condominios/{condominioId}/blocos/{blocoId}",
        "definition": {
            "entityName": "Bloco",
            "schema": { "$ref": "#/entities/Bloco" },
            "description": "Sub-coleção para organizar as unidades em blocos/torres."
        }
      },
      {
        "path": "/condominios/{condominioId}/blocos/{blocoId}/unidades/{unidadeId}",
        "definition": {
            "entityName": "Unidade",
            "schema": { "$ref": "#/entities/Unidade" },
            "description": "Sub-coleção para as unidades de um bloco."
        }
      },
      {
        "path": "/condominios/{condominioId}/blocos/{blocoId}/unidades/{unidadeId}/moradores/{uid}",
        "definition": {
            "entityName": "Morador",
            "schema": { "$ref": "#/entities/Morador" },
            "description": "Sub-coleção que lista os moradores de uma unidade específica."
        }
      },
      {
        "path": "/condominios/{condominioId}/config/menu",
        "definition": {
            "entityName": "ConfigMenu",
            "schema": { "$ref": "#/entities/ConfigMenu" },
            "description": "Documento singleton para armazenar as configurações de visibilidade do menu por papel para um condomínio."
        }
      },
      { "path": "/condominios/{condominioId}/anuncios/{anuncioId}", "definition": { "schema": { "$ref": "#/entities/Anuncio" }, "description": "Anúncios do condomínio." }},
      { "path": "/condominios/{condominioId}/reservas/{reservaId}", "definition": { "schema": { "$ref": "#/entities/Reserva" }, "description": "Reservas de áreas comuns." }},
      { "path": "/condominios/{condominioId}/reunioes/{reuniaoId}", "definition": { "schema": { "$ref": "#/entities/Reuniao" }, "description": "Reuniões e assembleias." }},
      { "path": "/condominios/{condominioId}/incidentes/{incidenteId}", "definition": { "schema": { "$ref": "#/entities/Incidente" }, "description": "Incidentes e chamados." }},
      { "path": "/condominios/{condominioId}/encomendas/{encomendaId}", "definition": { "schema": { "$ref": "#/entities/Encomenda" }, "description": "Encomendas recebidas." }},
      { "path": "/condominios/{condominioId}/documentos/{documentoId}", "definition": { "schema": { "$ref": "#/entities/Documento" }, "description": "Documentos gerais." }},
      { "path": "/condominios/{condominioId}/enquetes/{enqueteId}", "definition": { "schema": { "$ref": "#/entities/Enquete" }, "description": "Enquetes e votações." }},
      { "path": "/condominios/{condominioId}/acessos/{acessoId}", "definition": { "schema": { "$ref": "#/entities/Acesso" }, "description": "Controle de acesso." }},
      { "path": "/condominios/{condominioId}/cadastros/{cadastroId}", "definition": { "schema": { "$ref": "#/entities/Cadastro" }, "description": "Cadastros diversos (veículos, pets, etc.)." }},
      {
        "path": "/userCondominios/{uid}/vinculos/{condominioId}",
        "definition": {
            "entityName": "VinculoUsuario",
            "schema": { "$ref": "#/entities/VinculoUsuario" },
            "description": "Coleção de índice para consulta rápida. Permite que um usuário logado encontre todos os condomínios aos quais ele está associado, incluindo seu papel e, se aplicável, seu bloco e unidade."
        }
      }
    ],
    "queries": [
        {
            "description": "Listar todos os condomínios (Apenas Super Admin).",
            "query": "firestore.collection('condominios').get()"
        },
        {
            "description": "Listar os condomínios aos quais um usuário pertence.",
            "query": "firestore.collection(`userCondominios/${uid}/vinculos`).get()"
        },
        {
            "description": "Listar todos os blocos de um condomínio.",
            "query": "firestore.collection(`condominios/${condominioId}/blocos`).get()"
        },
        {
            "description": "Listar todas as unidades de um bloco.",
            "query": "firestore.collection(`condominios/${condominioId}/blocos/${blocoId}/unidades`).get()"
        },
        {
            "description": "Listar todos os moradores de uma unidade.",
            "query": "firestore.collection(`condominios/${condominioId}/blocos/${blocoId}/unidades/${unidadeId}/moradores`).get()"
        },
        {
            "description": "Obter os detalhes de um vínculo específico do usuário.",
            "query": "firestore.collection(`userCondominios/${uid}/vinculos`).doc(condominioId).get()"
        }
    ]
  }
}
