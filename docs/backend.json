        "role": { "type": "string", "enum": ["SUPER_ADMIN", "ADMIN_CONDOMINIO", "SINDICO", "SUB_SINDICO", "MORADOR", "PORTEIRO", "FUNCIONARIO"] },
        "scope": {
          "type": "object",
          "properties": {
            "type": { "type": "string", "enum": ["CONDOMINIO", "BLOCO"] },
            "blocoId": { "type": "string" }
          }
        },
        "ativo": { "type": "boolean" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Data da última sincronização com a coleção de membros." }
      },
