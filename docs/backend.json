{
  "entities": {
    "Condominio": {
      "title": "Condominio",
      "description": "Representa um único condomínio. Contém todas as suas sub-coleções de dados. Nota: Campos como 'createdAt' são representados como string 'date-time' para documentação, mas gravados como serverTimestamp() no Firestore.",
      "type": "object",
      "properties": {
        "nome": { "type": "string", "description": "Nome do condomínio." },
        "cnpj": { "type": "string", "description": "CNPJ do condomínio." },
        "cep": { "type": "string", "description": "CEP do endereço do condomínio." },
        "ativo": { "type": "boolean", "description": "Indica se o condomínio está ativo na plataforma." },
        "createdAt": { "type": "string", "format": "date-time", "description": "Data de criação do registro." },
        "createdBy": { "type": "string", "description": "UID do super_admin que criou o condomínio." }
      },
      "required": ["nome", "ativo", "createdAt", "createdBy"],
      "example": {
        "nome": "Condomínio Vila das Flores",
        "cnpj": "12.345.678/0001-99",
        "cep": "01234-567",
        "ativo": true,
        "createdAt": "2024-07-30T10:00:00Z",
        "createdBy": "p0XWt3ed7VgiEjHoItfmNq31cT62"
      }
    },
    "Bloco": {
      "title": "Bloco",
      "description": "Representa um bloco, torre ou setor dentro de um condomínio.",
      "type": "object",
      "properties": {
        "nome": { "type": "string", "description": "Nome ou identificador do bloco (Ex: 'Bloco A', 'Torre 1')." },
        "ordem": { "type": "number", "description": "Número para ordenação da exibição dos blocos." },
        "ativo": { "type": "boolean", "description": "Indica se o bloco está ativo." },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["nome", "ordem", "ativo", "createdAt"],
      "example": {
        "nome": "Bloco A",
        "ordem": 1,
        "ativo": true,
        "createdAt": "2024-07-30T10:05:00Z"
      }
    },
    "Unidade": {
      "title": "Unidade",
      "description": "Representa uma unidade individual (apartamento, casa) dentro de um bloco. Regras de consistência: se 'ocupacao' = 'ALUGADO', 'inquilinoUid' é obrigatório e 'responsavelUid' deve ser igual a 'inquilinoUid'. Se 'ocupacao' = 'PROPRIETARIO', 'proprietarioUid' é obrigatório, 'inquilinoUid' deve ser nulo e 'responsavelUid' deve ser igual a 'proprietarioUid'. Se 'ocupacao' = 'VAGO', 'inquilinoUid', 'proprietarioUid' e 'responsavelUid' devem ser nulos.",
      "type": "object",
      "properties": {
        "numero": { "type": "string", "description": "Número ou identificador da unidade (Ex: '101', 'Casa 23')." },
        "andar": { "type": "number", "description": "Andar da unidade." },
        "tipo": { "type": "string", "enum": ["APARTAMENTO", "CASA"], "description": "Tipo de unidade." },
        "ativo": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "proprietarioUid": { "type": ["string", "null"], "description": "UID do morador proprietário da unidade." },
        "inquilinoUid": { "type": ["string", "null"], "description": "UID do morador inquilino atual, se houver. Nulo se vago ou ocupado pelo proprietário." },
        "responsavelUid": { "type": ["string", "null"], "description": "UID do morador responsável (financeiro/legal) pela unidade." },
        "ocupacao": { "type": "string", "enum": ["VAGO", "PROPRIETARIO", "ALUGADO"], "description": "Status de ocupação da unidade." }
      },
      "required": ["numero", "tipo", "ativo", "createdAt", "ocupacao"],
      "examples": [
        {
          "title": "Unidade com Proprietário",
          "value": {
            "numero": "302",
            "andar": 3,
            "tipo": "APARTAMENTO",
            "ativo": true,
            "createdAt": "2024-07-30T10:10:00Z",
            "proprietarioUid": "abc123_user_uid_proprietario",
            "inquilinoUid": null,
            "responsavelUid": "abc123_user_uid_proprietario",
            "ocupacao": "PROPRIETARIO"
          }
        },
        {
          "title": "Unidade Alugada",
          "value": {
            "numero": "505",
            "andar": 5,
            "tipo": "APARTAMENTO",
            "ativo": true,
            "createdAt": "2024-07-30T10:15:00Z",
            "proprietarioUid": "jkl012_user_uid_outro_prop",
            "inquilinoUid": "def456_user_uid_inquilino",
            "responsavelUid": "def456_user_uid_inquilino",
            "ocupacao": "ALUGADO"
          }
        },
        {
          "title": "Unidade Vaga",
          "value": {
            "numero": "201",
            "andar": 2,
            "tipo": "APARTAMENTO",
            "ativo": true,
            "createdAt": "2024-07-30T10:20:00Z",
            "proprietarioUid": null,
            "inquilinoUid": null,
            "responsavelUid": null,
            "ocupacao": "VAGO"
          }
        }
      ]
    },
    "Morador": {
      "title": "Morador",
      "description": "Representa uma pessoa vinculada a uma unidade, seja proprietário, inquilino ou dependente. O ID do documento é o UID do usuário no Firebase Auth.",
      "type": "object",
      "properties": {
        "nome": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "tipo": { "type": "string", "enum": ["PROPRIETARIO", "INQUILINO", "DEPENDENTE"] },
        "isResponsavel": { "type": "boolean", "description": "Indica se é o responsável financeiro/legal pela unidade." },
        "status": { "type": "string", "enum": ["ATIVO", "INATIVO", "PENDENTE"] },
        "contrato": {
          "type": "object",
          "description": "Detalhes do contrato, aplicável apenas para inquilinos.",
          "properties": {
            "inicio": { "type": "string", "format": "date-time" },
            "fim": { "type": "string", "format": "date-time" },
            "imobiliaria": { "type": "string" }
          }
        },
        "responsavelId": { "type": "string", "description": "UID do morador responsável, aplicável para dependentes." },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["nome", "email", "tipo", "isResponsavel", "status", "createdAt"],
      "examples": [
