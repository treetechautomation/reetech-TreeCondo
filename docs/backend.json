{
  "entities": {
    "Condominio": {
      "title": "Condominio",
      "description": "Representa um único condomínio dentro do sistema SaaS.",
      "type": "object",
      "properties": {
        "nome": { "type": "string", "description": "Nome do condomínio." },
        "cnpj": { "type": "string", "description": "CNPJ do condomínio." },
        "cep": { "type": "string", "description": "CEP do endereço do condomínio." },
        "sindico": { "type": "string", "description": "Nome do síndico responsável." },
        "contato": { "type": "string", "description": "Telefone ou e-mail de contato." },
        "ativo": { "type": "boolean", "description": "Indica se o condomínio está ativo na plataforma." },
        "createdAt": { "type": "string", "format": "date-time", "description": "Data de criação do registro." },
        "createdBy": { "type": "string", "description": "UID do super_admin que criou o condomínio." }
      },
      "required": ["nome", "ativo", "createdAt", "createdBy"]
    },
    "UserProfile": {
      "title": "User Profile",
      "description": "Perfil de usuário global, ligando um UID de autenticação a papéis em um ou mais condomínios.",
      "type": "object",
      "properties": {
        "displayName": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "condominios": {
          "type": "object",
          "description": "Mapa de condomínios aos quais o usuário pertence, com seu papel em cada um.",
          "additionalProperties": {
            "type": "string",
            "enum": ["sindico", "morador", "porteiro"]
          }
        }
      },
      "required": ["displayName", "email", "condominios"]
    },
    "Resident": {
      "title": "Resident",
      "description": "Representa um morador dentro de um condomínio específico.",
      "type": "object",
      "properties": {
        "firstName": { "type": "string" },
        "lastName": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "phone": { "type": "string" },
        "unitNumber": { "type": "string" }
      },
      "required": ["firstName", "lastName", "email", "unitNumber"]
    },
    "Staff": {
      "title": "Staff",
      "description": "Representa um funcionário de um condomínio específico.",
      "type": "object",
      "properties": {
        "firstName": { "type": "string" },
        "lastName": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "phone": { "type": "string" },
        "position": { "type": "string" }
      },
      "required": ["firstName", "lastName", "email", "position"]
    }
  },
  "auth": {
    "providers": ["password", "anonymous"],
    "customClaims": ["super_admin"]
  },
  "firestore": {
    "structure": [
      {
        "path": "/condominios/{condominioId}",
        "definition": {
          "entityName": "Condominio",
          "schema": { "$ref": "#/entities/Condominio" },
          "description": "Coleção principal que armazena cada condomínio como um documento. Acesso de escrita restrito a super_admins."
        }
      },
      {
        "path": "/users/{userId}",
        "definition": {
          "entityName": "UserProfile",
          "schema": { "$ref": "#/entities/UserProfile" },
          "description": "Coleção de perfis de usuário globais. Cada documento mapeia um UID de autenticação para seus papéis nos condomínios. Essencial para controle de acesso multi-condomínio."
        }
      },
      {
        "path": "/condominios/{condominioId}/residents/{residentId}",
        "definition": {
          "entityName": "Resident",
          "schema": { "$ref": "#/entities/Resident" },
          "description": "Sub-coleção de moradores para um condomínio específico. Isolado por condominioId."
        }
      },
      {
        "path": "/condominios/{condominioId}/staff/{staffId}",
        "definition": {
          "entityName": "Staff",
          "schema": { "$ref": "#/entities/Staff" },
          "description": "Sub-coleção de funcionários para um condomínio específico. Isolado por condominioId."
        }
      }
    ]
  }
}
