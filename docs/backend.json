            "uid": "UID_SINDICO_DALIAS",
            "role": "SINDICO",
            "ativo": true,
            "createdAt": "2024-07-31T10:01:00Z",
            "createdBy": "UID_ADMIN",
            "scope": {
              "type": "BLOCO",
              "condominioId": "chacara-itaguai",
              "blocoId": "dalias"
            }
          }
        },
        {
          "title": "Síndico do Bloco Rosas",
          "id": "UID_SINDICO_ROSAS",
          "value": {
            "uid": "UID_SINDICO_ROSAS",
            "role": "SINDICO",
            "ativo": true,
            "createdAt": "2024-07-31T10:02:00Z",
            "createdBy": "UID_ADMIN",
            "scope": {
              "type": "BLOCO",
              "condominioId": "chacara-itaguai",
              "blocoId": "rosas"
            }
          }
        }
      ]
    },
