rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Funções de Ajuda ---

    function signedIn() { 
      return request.auth != null; 
    }

    // Aceita os 2 formatos de claim para Super Admin.
    function isSuper() {
      return signedIn() && (
        request.auth.token.super_admin == true ||
        request.auth.token.superAdmin == true
      );
    }

    // --- Fonte da Verdade para Permissões de Staff: /condominios/{condId}/membros/{uid} ---
    
    // Retorna o documento de membro do usuário no condomínio especificado.
    function membroDoc(condominioId) {
      return get(/databases/$(database)/documents/condominios/$(condominioId)/membros/$(request.auth.uid));
    }

    // Verifica se o usuário é um membro com status "ATIVO" no condomínio.
    function isMembroAtivo(condominioId) {
      return signedIn() && membroDoc(condominioId).exists && membroDoc(condominioId).data.status == "ATIVO";
    }
    
    // Retorna a role do membro no condomínio.
    function roleNoCondo(condominioId) {
      return membroDoc(condominioId).data.role;
    }

    // Verifica se o usuário tem uma role de gestão (ADMIN ou SINDICO) no condomínio.
    function canManageCondo(condominioId) {
      return isSuper() || (isMembroAtivo(condominioId) && (roleNoCondo(condominioId) in ["ADMIN", "SINDICO"]));
    }


    // =========================================================
    // ✅ REGRAS PARA SESSÃO (ESSENCIAL PARA O APP FUNCIONAR)
    // =========================================================

    // Permite que o usuário leia seu próprio perfil (nome, etc).
    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      // Escrita normalmente via API/Admin SDK. Se precisar pelo client, libere para o próprio usuário:
      allow create, update: if signedIn() && request.auth.uid == uid;
      allow delete: if isSuper();
    }

    // Permite que o usuário leia seus próprios vínculos para montar o seletor de condomínios.
    match /userCondominios/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if isSuper(); // Vínculos são criados/gerenciados pelo sistema ou admin.

      match /vinculos/{condominioId} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow write: if isSuper(); 
      }
    }


    // =========================================================
    // ✅ COLEÇÕES PÚBLICAS E PRINCIPAIS
    // =========================================================

    // Coleção pública para listar nomes de condomínios no seletor.
    match /condominiosPublicos/{id} {
      allow read: if signedIn();
      allow write: if isSuper();
    }

    // Coleção principal que contém todos os dados de cada condomínio.
    match /condominios/{condominioId} {
      // Um usuário pode ler o documento principal do condomínio se for Super Admin ou um membro ativo.
      allow read: if isSuper() || isMembroAtivo(condominioId);
      // Apenas Super Admin pode criar, editar ou deletar o documento principal.
      allow create, update, delete: if isSuper();

      // --- Subcoleções ---

      match /membros/{uid} {
        // Um usuário pode ler seu próprio documento de membro.
        // Um gestor ou Super Admin pode ler todos os membros.
        allow read: if isSuper() || (isMembroAtivo(condominioId) && (request.auth.uid == uid || canManageCondo(condominioId)));
        
        // Apenas gestores ou Super Admins podem gerenciar membros.
        allow create, update, delete: if canManageCondo(condominioId);
      }

      match /anuncios/{anuncioId} {
        // Qualquer membro ativo do condomínio (ou Super Admin) pode ler os anúncios.
        allow read: if isSuper() || isMembroAtivo(condominioId);
        
        // Apenas gestores (ADMIN/SINDICO) ou Super Admin podem criar/editar/deletar anúncios.
        allow create, update, delete: if canManageCondo(condominioId);
      }
      
      // Regra para configuração, se necessário.
      match /config/{docId} {
        allow read: if isSuper() || isMembroAtivo(condominioId);
        allow write: if canManageCondo(condominioId);
      }
      
      // Regra genérica para outras subcoleções (blocos, unidades, etc.)
      match /{subcollection}/{docId=**} {
         allow read: if isSuper() || isMembroAtivo(condominioId);
         allow write: if canManageCondo(condominioId);
      }
    }
  }
}
