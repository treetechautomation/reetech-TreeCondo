rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // aceita os 2 nomes (porque às vezes você setou um ou outro)
    function isSuper() {
      return isSignedIn()
        && (request.auth.token.super_admin == true
            || request.auth.token.superAdmin == true);
    }

    // Fonte de verdade: membro do condomínio
    function membroDoc(condominioId) {
      return get(/databases/$(database)/documents/condominios/$(condominioId)/membros/$(request.auth.uid));
    }

    function isMembroAtivo(condominioId) {
      return isSignedIn()
        && membroDoc(condominioId).exists()
        && membroDoc(condominioId).data.status == "ATIVO";
    }

    function roleNoCondo(condominioId) {
      return membroDoc(condominioId).data.role;
    }

    function canManageCondo(condominioId) {
      return isSuper()
        || (isMembroAtivo(condominioId)
            && (roleNoCondo(condominioId) in ["ADMIN", "SINDICO"]));
    }

    // ✅ ANÚNCIOS NO PATH REAL
    match /condominios/{condominioId}/anuncios/{anuncioId} {

      // Ler: super OU qualquer membro ATIVO do condomínio
      allow read: if isSuper() || isMembroAtivo(condominioId);

      // Criar: super OU ADMIN/SINDICO ATIVO
      allow create: if canManageCondo(condominioId)
        // opcional, mas recomendo: garante consistência do doc
        && (!("condominioId" in request.resource.data) || request.resource.data.condominioId == condominioId);

      // Atualizar/Deletar: super OU ADMIN/SINDICO ATIVO
      allow update, delete: if canManageCondo(condominioId);
    }
  }
}
