rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isSuper() {
      return request.auth != null &&
        (request.auth.token.super_admin == true || request.auth.token.superAdmin == true);
    }

    // Se você tiver role em custom claims (recomendado), libera write também:
    function isOperator() {
      return isSignedIn() && (
        isSuper() ||
        request.auth.token.role in ['SUPER_ADMIN','ADMIN_CONDOMINIO','ADMIN','SINDICO']
      );
    }

    // Documentos do condomínio
    match /condominios/{condominioId}/documentos/{docId}/{fileName} {
      allow read: if isSignedIn();    // morador baixa/abre
      allow write: if isOperator();   // só admin/síndico/super
    }

    // fallback: nega o resto
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
