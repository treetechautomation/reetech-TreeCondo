
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------
    // Helpers Globais
    // -------------------------
    function signedIn() {
      return request.auth != null;
    }

    function isSuper() {
      return signedIn() && (
        request.auth.token.super_admin == true ||
        request.auth.token.superAdmin == true
      );
    }

    function memberPath(condominioId) {
      return /databases/$(database)/documents/condominios/$(condominioId)/membros/$(request.auth.uid);
    }

    function hasMember(condominioId) {
      return signedIn() && exists(memberPath(condominioId));
    }

    function membroData(condominioId) {
      return get(memberPath(condominioId)).data;
    }

    function isMembroAtivo(condominioId) {
      return hasMember(condominioId) && (membroData(condominioId).status == null ? "" : membroData(condominioId).status).upper() == "ATIVO";
    }

    function role(condominioId) {
      return (membroData(condominioId).role == null ? "" : membroData(condominioId).role).upper();
    }
    
    function isOperador(condominioId) {
      return isMembroAtivo(condominioId) && (role(condominioId) in ["SINDICO","ADMIN","ADMIN_CONDOMINIO","SUPER_ADMIN"]);
    }
    
    function isPortaria(condominioId) {
        return isMembroAtivo(condominioId) && (role(condominioId) in ["PORTEIRO","SEGURANCA"]);
    }

    function isPortariaOrOperador(condominioId) {
      return isOperador(condominioId) || isPortaria(condominioId);
    }

    function isMorador(condominioId) {
      return isMembroAtivo(condominioId) && role(condominioId) == "MORADOR";
    }

    function isZelador(condominioId) {
      return isMembroAtivo(condominioId) && role(condominioId) == 'ZELADOR';
    }

    // -------------------------
    // Coleções Globais
    // -------------------------
    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid;
      allow delete: if isSuper();

      match /fcmTokens/{tokenId} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow create, update: if signedIn() && request.auth.uid == uid;
        allow delete: if signedIn() && request.auth.uid == uid;
      }
    }

    match /userCondominios/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if isSuper();

      match /vinculos/{condominioId} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow write: if isSuper();
      }
    }

    match /condominiosPublicos/{id} {
      allow read: if signedIn();
      allow write: if isSuper();
    }

    // -------------------------
    // Condomínios e Subcoleções
    // -------------------------
    match /condominios/{condominioId} {

      allow read: if isSuper() || isMembroAtivo(condominioId);
      allow create, update, delete: if isSuper();
      
      // =========================
      // ACESSOS (visitas/entregas)
      // =========================
      match /acessos/{acessoId} {
        // leitura: operador/portaria veem tudo; morador vê só os dele
        allow read: if isPortariaOrOperador(condominioId)
          || (isMorador(condominioId) && resource.data.moradorUid == request.auth.uid);

        // criação: operador cria qualquer; morador cria apenas pra ele mesmo
        allow create: if isOperador(condominioId)
          || (isMorador(condominioId) && request.resource.data.moradorUid == request.auth.uid);

        // update: portaria ou operador podem atualizar; morador só se dono e PENDENTE
        allow update: if isPortariaOrOperador(condominioId)
          || (isMorador(condominioId) && resource.data.moradorUid == request.auth.uid && resource.data.status == "PENDENTE");

        // delete: operador pode; morador só se dono e PENDENTE
        allow delete: if isOperador(condominioId)
          || (isMorador(condominioId) && resource.data.moradorUid == request.auth.uid && resource.data.status == "PENDENTE");
      }
      
      // --- REGRAS DE MANUTENÇÃO PREVENTIVA ---
      match /manutencaoRotinas/{rotinaId} {
        allow read: if isMembroAtivo(condominioId);
        allow write: if canManageCondo(condominioId);
      }
      
      match /manutencaoExecucoes/{execucaoId} {
          allow read: if isMembroAtivo(condominioId);
          allow create: if canManageCondo(condominioId);
          allow update: if canManageCondo(condominioId) || isZelador(condominioId) || isPorteiro(condominioId);
          allow delete: if canManageCondo(condominioId);
      }

      match /manutencaoFornecedores/{fornecedorId} {
        allow read: if isMembroAtivo(condominioId);
        allow write: if canManageCondo(condominioId);
      }

      // --- REGRAS DE DOCUMENTOS ---
      match /documentos/{docId} {
        allow read: if isSuper() || isMembroAtivo(condominioId);
        allow create, update, delete: if canManageCondo(condominioId);
      }

        // --- REGRAS DE REUNIÕES ---
        match /reunioes/{reuniaoId} {
          allow read: if isSuper() || isMembroAtivo(condominioId);
          allow create, update, delete: if canManageCondo(condominioId);
        }


        // -------------------------
        // ENQUETES E VOTAÇÕES
        // -------------------------
        match /enquetes/{enqueteId} {

          // Leitura: qualquer membro ativo do condomínio
          allow read: if isMembroAtivo(condominioId) || isSuper();

          // Criar enquete: gestor do condomínio
          allow create: if canManageCondo(condominioId);

          // Encerrar/editar enquete: gestor
          // (encerrar usa updateDoc na enquete)
          allow update, delete: if canManageCondo(condominioId)
            || (
              // Permitir apenas update de contadores pelo morador via transaction
              // (totalVotes e updatedAt) e sem mudar status/título/descrição
              isMembroAtivo(condominioId)
              && request.resource.data.diff(resource.data).changedKeys().hasOnly(['totalVotes','updatedAt'])
              && request.resource.data.status == resource.data.status
              && request.resource.data.titulo == resource.data.titulo
              && request.resource.data.descricao == resource.data.descricao
              && request.resource.data.createdAt == resource.data.createdAt
              && request.resource.data.createdByUid == resource.data.createdByUid
              && request.resource.data.createdByNome == resource.data.createdByNome
            );

          // Opções da enquete
          match /opcoes/{opcaoId} {
            allow read: if isMembroAtivo(condominioId) || isSuper();

            // Gestor cria/edita/apaga opções
            allow create, delete: if canManageCondo(condominioId);

            // Update: gestor OU morador apenas incrementando "votes"
            allow update: if canManageCondo(condominioId)
              || (
                isMembroAtivo(condominioId)
                && request.resource.data.diff(resource.data).changedKeys().hasOnly(['votes'])
                && request.resource.data.texto == resource.data.texto
                && request.resource.data.order == resource.data.order
              );
          }

          // Voto único por usuário: votos/{uid}
          match /votos/{uid} {
            // leitura só do próprio voto (se quiser liberar para gestor, dá pra abrir)
            allow read: if signedIn() && request.auth.uid == uid && (isMembroAtivo(condominioId) || isSuper());

            // Criar voto: apenas o próprio uid e se ainda não existir
            allow create: if signedIn()
              && request.auth.uid == uid
              && (isMembroAtivo(condominioId) || isSuper())
              && !exists(/databases/$(database)/documents/condominios/$(condominioId)/enquetes/$(enqueteId)/votos/$(uid))
              && request.resource.data.keys().hasOnly(['opcaoId','createdAt'])
              && request.resource.data.opcaoId is string;

            // Não permitir alterar voto (mantém voto único)
            allow update, delete: if false;
          }
        }


      // -------------------------
      // Áreas Reserváveis
      // - leitura: qualquer membro ativo do condomínio
      // - escrita: admin/síndico (canManageCondo)
      // -------------------------
      match /areasReservaveis/{areaId} {
        allow read: if isSuper() || isMembroAtivo(condominioId);
        allow create, update, delete: if canManageCondo(condominioId);
      }

      match /membros/{uid} {
        allow read: if isSuper()
                    || (signedIn() && request.auth.uid == uid)
                    || canManageCondo(condominioId);
        
        allow create, update, delete: if canManageCondo(condominioId);

        // Morador pode atualizar seu próprio PIN
        allow update: if signedIn() && request.auth.uid == uid
                      && request.resource.data.diff(resource.data).changedKeys()
                         .hasOnly(['encomendaPinHash', 'encomendaPinLast4', 'encomendaPinUpdatedAt', 'updatedAt', 'encomendaPinFailedAttempts']);
      }

      match /anuncios/{anuncioId} {
        allow read: if isSuper() || isMembroAtivo(condominioId);
        allow create, update, delete: if canManageCondo(condominioId);
      }

        // -------------------------
        // Encomendas e Notificações (Privacidade por Unidade)
        // -------------------------
        match /encomendas/{encomendaId} {
          function isMyUnidade() {
            let membro = membroData(condominioId);
            let encomenda = resource.data;
            return membro.unidadeIdNorm == encomenda.unidadeIdNorm &&
                   (encomenda.blocoIdNorm == null || membro.blocoIdNorm == encomenda.blocoIdNorm);
          }

          allow read: if isSuper() || canManageCondo(condominioId) || isPorteiro(condominioId) || isZelador(condominioId)
                      || (isMembroAtivo(condominioId) && isMyUnidade());
          
          allow create: if canManageCondo(condominioId) || isPorteiro(condominioId) || isZelador(condominioId);

          allow update: if canManageCondo(condominioId) || isPorteiro(condominioId) || isZelador(condominioId);

          allow delete: if isSuper() || canManageCondo(condominioId);
        }

        match /notificacoes/{notificacaoId} {
          function isForMe() {
            return signedIn() && resource.data.targetUid == request.auth.uid;
          }
          
          allow read: if isForMe();
          allow create: if canManageCondo(condominioId) || isPorteiro(condominioId) || isZelador(condominioId);
          allow update: if isForMe(); // para marcar como lida
          allow delete: if isForMe();
        }

      // --- REGRAS DE INCIDENTES ---
      match /incidentes/{incidenteId} {
        
        function isOwner() {
          return signedIn() && resource.data.criadoPorUid == request.auth.uid;
        }

        // Leitura: Gestores podem ler tudo. Moradores podem ler apenas os seus.
        allow get: if canManageCondo(condominioId) || (isMembroAtivo(condominioId) && isOwner());
        allow list: if canManageCondo(condominioId) || isMembroAtivo(condominioId); // Filtro é feito no client-side query

        // Escrita: Morador pode criar. Gestores podem criar em nome de outros (via API).
        allow create: if signedIn() && 
                         (request.resource.data.criadoPorUid == request.auth.uid || canManageCondo(condominioId));

        // Update: Gestores podem mudar o status. Dono pode avaliar.
        allow update: if (canManageCondo(condominioId) && 
                         request.resource.data.diff(resource.data).changedKeys().hasOnly(['status', 'updatedAt']))
                      || 
                      (isOwner() && 
                         request.resource.data.diff(resource.data).changedKeys().hasOnly(['avaliacao', 'updatedAt']) &&
                         (resource.data.status == 'RESOLVIDO' || resource.data.status == 'FINALIZADO'));
        
        // Deletar: Apenas gestores.
        allow delete: if canManageCondo(condominioId);

        match /historico/{histId} {
          // Leitura: quem pode ler o incidente, pode ler o histórico.
          allow read: if canManageCondo(condominioId) || isOwner();

          // Escrita: Gestores ou o dono do incidente podem adicionar ao histórico.
          allow create: if canManageCondo(condominioId) || isOwner();
        }
      }

      match /config/{docId} {
        allow read: if isSuper() || isMembroAtivo(condominioId);
        allow write: if canManageCondo(condominioId);
      }

      // --- REGRAS DE RESERVAS E CONVIDADOS ---
      match /reservas/{reservaId} {
        function isOwner() {
            let r = resource.data;
            return signedIn() && (
              r.uid == request.auth.uid ||
              r.userId == request.auth.uid ||
              r.moradorUid == request.auth.uid ||
              r.createdByUid == request.auth.uid ||
              (r.createdBy != null && r.createdBy.uid == request.auth.uid)
            );
          }

        allow read: if canManageCondo(condominioId) || isOwner()
                    || (isPorteiro(condominioId) && resource.data.status == 'APROVADA');

        allow create: if isMembroAtivo(condominioId)
                      && request.resource.data.uid == request.auth.uid;
        
        allow update: if canManageCondo(condominioId)
                      || (
                           isPorteiro(condominioId) &&
                           request.resource.data.diff(resource.data).changedKeys()
                             .hasOnly(['statusAcesso', 'entradaEm', 'porteiroUid', 'updatedAt'])
                         );

        allow delete: if isSuper() || canManageCondo(condominioId);

        match /convidados/{convidadoId} {
            function getReservaDoc() {
              return get(/databases/$(database)/documents/condominios/$(condominioId)/reservas/$(reservaId));
            }

            function isParentReservaOwner() {
                let reserva = getReservaDoc().data;
                return signedIn() && (
                  reserva.uid == request.auth.uid ||
                  reserva.userId == request.auth.uid ||
                  reserva.moradorUid == request.auth.uid ||
                  reserva.createdByUid == request.auth.uid ||
                  (reserva.createdBy != null && reserva.createdBy.uid == request.auth.uid)
                );
              }

            allow read: if isSuper() || canManageCondo(condominioId) || isParentReservaOwner() ||
                        (isPorteiro(condominioId) && getReservaDoc().data.status == 'APROVADA');

            allow create, delete: if isSuper() || canManageCondo(condominioId) || isParentReservaOwner();
            
            allow update: if canManageCondo(condominioId) ||
                          (isPorteiro(condominioId)
                            && getReservaDoc().data.status == 'APROVADA'
                            && request.resource.data.status == 'ENTROU'
                            && request.resource.data.diff(resource.data).changedKeys()
                                 .hasOnly(['status', 'entradaEm', 'porteiroUid', 'updatedAt']));
          }
      }
      
      // -------------------------
      // Comunicação (Threads / Mensagens)
      // -------------------------
      match /threads/{threadId} {
        allow read: if isSuper() || isMembroAtivo(condominioId);
        allow create, update, delete: if canManageCondo(condominioId);

        match /mensagens/{msgId} {
          allow read: if isSuper() || isMembroAtivo(condominioId);

          allow create: if canManageCondo(condominioId)
            || (
              isMembroAtivo(condominioId)
              && role(condominioId) == "MORADOR"
              && get(/databases/$(database)/documents/condominios/$(condominioId)/threads/$(threadId)).data.tipo == "MORADOR"
              && get(/databases/$(database)/documents/condominios/$(condominioId)/threads/$(threadId)).data.moradorReplyEnabled == true
              && (
                get(/databases/$(database)/documents/condominios/$(condominioId)/threads/$(threadId)).data.alvo.uid == request.auth.uid
                || get(/databases/$(database)/documents/condominios/$(condominioId)/threads/$(threadId)).data.alvo.uidMorador == request.auth.uid
              )
              && request.resource.data.createdByUid == request.auth.uid
            );

          allow update, delete: if canManageCondo(condominioId);
        }
      }

      // outras subcoleções: leitura p/ membro ativo; escrita p/ admin/síndico
      match /{subcollection}/{docId=**} {
        allow read: if isSuper() || isMembroAtivo(condominioId);
        allow write: if canManageCondo(condominioId);
      }

    }
  }
}
