
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =================================
    // Helper Functions
    // =================================
    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isSignedIn() && request.auth.token.super_admin == true;
    }
    
    function isMember(condominioId) {
        return exists(/databases/$(database)/documents/condominios/$(condominioId)/membros/$(request.auth.uid));
    }

    function hasRole(condominioId, role) {
        let userRole = get(/databases/$(database)/documents/condominios/$(condominioId)/membros/$(request.auth.uid)).data.role;
        return userRole == role;
    }

    // =================================
    // Collections
    // =================================

    // Coleção de condomínios. Acesso de escrita restrito a super_admins.
    // Leitura permitida para usuários autenticados para listagem.
    match /condominios/{condominioId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();

      // Sub-coleção de membros. Acesso de escrita restrito a síndicos e super_admins.
      match /membros/{uid} {
          allow read, list: if isMember(condominioId) || isSuperAdmin();
          allow write: if hasRole(condominioId, 'sindico') || isSuperAdmin();
      }

      // Documento de configuração do menu. Acesso de escrita para síndicos e super_admins.
      match /config/menu {
        allow read: if isMember(condominioId);
        allow write: if hasRole(condominioId, 'sindico') || isSuperAdmin();
      }
      
      // Regra genérica para as demais sub-coleções (anuncios, reservas, etc.)
      match /{subcollection}/{docId} {
        allow read, list: if isMember(condominioId);
        allow write: if hasRole(condominioId, 'sindico') || isSuperAdmin() || (subcollection == 'incidentes' && request.auth.uid == resource.data.createdBy);
      }
    }

    // Coleção de índice para consulta rápida dos vínculos do usuário.
    // O usuário só pode ler seus próprios vínculos. A escrita é controlada por Cloud Functions (processo administrativo).
    match /userCondominios/{uid} {
      allow read, write: if request.auth.uid == uid;
      
      match /vinculos/{condominioId} {
        allow read, list: if request.auth.uid == uid;
        allow write: if isSuperAdmin(); // Apenas super_admin pode vincular/desvincular
      }
    }
  }
}
