
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =================================
    // Helper Functions
    // =================================
    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isSignedIn() && request.auth.token.super_admin == true;
    }
    
    // Verifica se o usuário é um membro (independente do status)
    function isMember(condominioId) {
        return exists(/databases/$(database)/documents/condominios/$(condominioId)/membros/$(request.auth.uid));
    }

    // Verifica se o usuário é um membro ATIVO
    function isActiveMember(condominioId) {
        return isMember(condominioId) && get(/databases/$(database)/documents/condominios/$(condominioId)/membros/$(request.auth.uid)).data.status == 'ativo';
    }

    function hasRole(condominioId, role) {
        return isActiveMember(condominioId) && get(/databases/$(database)/documents/condominios/$(condominioId)/membros/$(request.auth.uid)).data.role == role;
    }

    // =================================
    // Collections
    // =================================

    // Coleção principal de condomínios
    match /condominios/{condominioId} {
      // Super admin pode tudo. Membros ativos podem ler os dados do seu condomínio.
      allow read: if isSuperAdmin() || isActiveMember(condominioId);
      // Apenas super admins podem criar, editar ou apagar condomínios.
      allow write: if isSuperAdmin();

      // Sub-coleções dentro de um condomínio
      match /{subcollection}/{docId} {
        // Acesso de leitura/escrita para super admins ou membros ativos do condomínio.
        allow read, write: if isSuperAdmin() || isActiveMember(condominioId);
      }
    }

    // Coleção de índice para consulta rápida dos vínculos do usuário.
    match /userCondominios/{uid} {
      // Um usuário só pode ler/escrever em seu próprio documento de vínculos.
      // Super admin pode acessar qualquer um.
      allow read, write: if isSuperAdmin() || request.auth.uid == uid;
      
      match /vinculos/{condominioId} {
         // A regra do pai já cobre, mas podemos ser explícitos.
        allow read, write: if isSuperAdmin() || request.auth.uid == uid;
      }
    }
  }
}
