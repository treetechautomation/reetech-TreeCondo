rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------
    // Helpers Globais
    // -------------------------
    function signedIn() {
      return request.auth != null;
    }

    function isSuper() {
      return signedIn() && (
        request.auth.token.super_admin == true ||
        request.auth.token.superAdmin == true
      );
    }

    function memberPath(condominioId) {
      return /databases/$(database)/documents/condominios/$(condominioId)/membros/$(request.auth.uid);
    }

    function hasMember(condominioId) {
      return signedIn() && exists(memberPath(condominioId));
    }

    function memberDoc(condominioId) {
      return get(memberPath(condominioId));
    }

    function isMembroAtivo(condominioId) {
      return hasMember(condominioId) && memberDoc(condominioId).data.status == "ATIVO";
    }

    function roleNoCondo(condominioId) {
      return hasMember(condominioId) ? memberDoc(condominioId).data.role : null;
    }

    function canManageCondo(condominioId) {
      return isSuper() || (
        isMembroAtivo(condominioId) &&
        (roleNoCondo(condominioId) in ["ADMIN", "SINDICO", "ADMIN_CONDOMINIO"])
      );
    }

    function isPorteiro(condominioId) {
      return isMembroAtivo(condominioId) && roleNoCondo(condominioId) == 'PORTEIRO';
    }


    // -------------------------
    // Coleções Globais
    // -------------------------
    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid;
      allow delete: if isSuper();

      match /fcmTokens/{tokenId} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow create, update: if signedIn() && request.auth.uid == uid;
        allow delete: if signedIn() && request.auth.uid == uid;
      }

    }

    match /userCondominios/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if isSuper();

      match /vinculos/{condominioId} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow write: if isSuper();
      }
    }

    match /condominiosPublicos/{id} {
      allow read: if signedIn();
      allow write: if isSuper();
    }

    // -------------------------
    // Condomínios e Subcoleções
    // -------------------------
    match /condominios/{condominioId} {

      allow read: if isSuper() || isMembroAtivo(condominioId);
      allow create, update, delete: if isSuper();

      match /membros/{uid} {
        allow read: if isSuper()
                    || (signedIn() && request.auth.uid == uid)
                    || canManageCondo(condominioId);

        allow create, update, delete: if canManageCondo(condominioId);
      }

      match /anuncios/{anuncioId} {
        allow read: if isSuper() || isMembroAtivo(condominioId);
        allow create, update, delete: if canManageCondo(condominioId);
      }

      match /config/{docId} {
        allow read: if isSuper() || isMembroAtivo(condominioId);
        allow write: if canManageCondo(condominioId);
      }

      // --- REGRAS DE RESERVAS E CONVIDADOS ---
      match /reservas/{reservaId} {
        function isOwner() {
          return signedIn() && (resource.data.uid == request.auth.uid || resource.data.userId == request.auth.uid);
        }

        allow read: if canManageCondo(condominioId) || isOwner()
                    || (isPorteiro(condominioId) && resource.data.status == 'APROVADA');

        allow create: if isMembroAtivo(condominioId)
                      && (roleNoCondo(condominioId) == 'MORADOR' || roleNoCondo(condominioId) == 'SINDICO')
                      && request.resource.data.uid == request.auth.uid
                      && request.resource.data.status == 'PENDENTE'
                      && request.resource.data.condominioId == condominioId
                      && request.resource.data.data is timestamp;

        allow update: if canManageCondo(condominioId)
                      || (
                           isPorteiro(condominioId) &&
                           request.resource.data.diff(resource.data).changedKeys()
                             .hasOnly(['statusAcesso', 'entradaEm', 'porteiroUid', 'updatedAt'])
                         );

        allow delete: if isSuper();

        match /convidados/{convidadoId} {
          function isReservaOwner() {
            let reserva = get(/databases/$(database)/documents/condominios/$(condominioId)/reservas/$(reservaId));
            return signedIn() && (reserva.data.uid == request.auth.uid || reserva.data.userId == request.auth.uid);
          }

          allow read: if canManageCondo(condominioId) || isPorteiro(condominioId) || isReservaOwner();

          allow create, delete: if canManageCondo(condominioId) || isReservaOwner();

          allow update: if (canManageCondo(condominioId) || isPorteiro(condominioId))
                        && request.resource.data.diff(resource.data).changedKeys()
                             .hasOnly(['status', 'entrouEm', 'porteiroUid', 'updatedAt'])
                        && request.resource.data.status == 'ENTROU';
        }
      }
      // -------------------------
      // Comunicação (Threads / Mensagens)
      // -------------------------
      match /threads/{threadId} {
        allow read: if isSuper() || isMembroAtivo(condominioId);

        allow create: if canManageCondo(condominioId);

        allow update: if canManageCondo(condominioId) || (
          isMembroAtivo(condominioId) &&
          roleNoCondo(condominioId) == "MORADOR" &&
          resource.data.tipo == "MORADOR" &&
          (resource.data.alvo.uid == request.auth.uid) &&
          resource.data.moradorReplyEnabled == true &&
          request.resource.data.diff(resource.data).changedKeys().hasOnly(["updatedAt", "lastMessage"])
        );

        allow delete: if canManageCondo(condominioId) || isSuper();

        match /mensagens/{msgId} {
          allow read: if isSuper() || isMembroAtivo(condominioId);

          allow create: if canManageCondo(condominioId) || (
            isMembroAtivo(condominioId) &&
            roleNoCondo(condominioId) == "MORADOR" &&
            get(/databases/$(database)/documents/condominios/$(condominioId)/threads/$(threadId)).data.tipo == "MORADOR" &&
            get(/databases/$(database)/documents/condominios/$(condominioId)/threads/$(threadId)).data.moradorReplyEnabled == true &&
            get(/databases/$(database)/documents/condominios/$(condominioId)/threads/$(threadId)).data.alvo.uid == request.auth.uid &&
            request.resource.data.createdByUid == request.auth.uid &&
            request.resource.data.createdAt is timestamp &&
            request.resource.data.texto is string &&
            request.resource.data.texto.size() > 0
          );

          allow update, delete: if canManageCondo(condominioId) || isSuper();
        }
      }



      // outras subcoleções: leitura p/ membro ativo; escrita p/ admin/síndico
      match /{subcollection}/{docId=**} {
        allow read: if isSuper() || isMembroAtivo(condominioId);
        allow write: if canManageCondo(condominioId);
      }
    }
  }
}
