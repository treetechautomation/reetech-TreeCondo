rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Funções de Ajuda ---
    
    function isSignedIn() {
      return request.auth != null;
    }

    // isSuperAdmin agora checa a claim OU o e-mail específico.
    function isSuperAdmin() {
      return isSignedIn() && (
        request.auth.token.super_admin == true ||
        request.auth.token.email == "treecommunity@treetechautomation.com"
      );
    }
    
    // Verifica se um usuário tem um vínculo ATIVO com um condomínio.
    function hasActiveLink(condominioId) {
      return isSignedIn() &&
             exists(/databases/$(database)/documents/userCondominios/$(request.auth.uid)/vinculos/$(condominioId)) &&
             get(/databases/$(database)/documents/userCondominios/$(request.auth.uid)/vinculos/$(condominioId)).data.status == "ATIVO";
    }

    function getRoleInCondo(condominioId) {
      // Importante: Sempre use hasActiveLink() antes de chamar esta função.
      return get(/databases/$(database)/documents/userCondominios/$(request.auth.uid)/vinculos/$(condominioId)).data.role;
    }

    // --- Regras por Coleção ---

    // Coleção pública, mas apenas para usuários logados. Super Admin pode escrever.
    match /condominiosPublicos/{condominioId} {
      allow read: if isSignedIn(); // Qualquer usuário logado pode ler
      allow write: if isSuperAdmin();
    }

    // Coleção principal de condomínios
    match /condominios/{condominioId} {
      // Leitura permitida para Super Admin ou usuários com vínculo ativo.
      allow read: if isSuperAdmin() || hasActiveLink(condominioId);
      
      // Escrita permitida para Super Admin ou Síndicos do próprio condomínio.
      allow write: if isSuperAdmin() || (hasActiveLink(condominioId) && getRoleInCondo(condominioId) == 'SINDICO');

      // Regra genérica para subcoleções (anuncios, membros, etc.)
      match /{subcollection}/{docId} {
        allow read: if isSuperAdmin() || hasActiveLink(condominioId);
        allow write: if isSuperAdmin() || (hasActiveLink(condominioId) && getRoleInCondo(condominioId) == 'SINDICO');
      }
    }
    
    // Regra para a coleção de vínculos de usuário
    match /userCondominios/{uid}/{document=**} {
      // Um usuário só pode ler e escrever seus próprios documentos de vínculo.
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }
  }
}
