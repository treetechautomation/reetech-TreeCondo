rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =====================================================================
    // HELPER FUNCTIONS
    // =====================================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isSignedIn() && request.auth.token.super_admin == true;
    }
    
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isCreatedAtUnchanged() {
      return request.resource.data.createdAt == resource.data.createdAt;
    }
    
    // --- CONDOMINIO LEVEL HELPERS ---

    function getMembroRole(condominioId, uid) {
      return get(/databases/$(database)/documents/condominios/$(condominioId)/membros/$(uid)).data.role;
    }

    function isSindico(condominioId) {
        return isSignedIn() && getMembroRole(condominioId, request.auth.uid) == 'SINDICO';
    }

    function isPorteiro(condominioId) {
        return isSignedIn() && getMembroRole(condominioId, request.auth.uid) == 'PORTEIRO';
    }
    
    function isCondoStaff(condominioId) {
      return isSindico(condominioId) || isPorteiro(condominioId);
    }
    
    function getVinculo(uid, condominioId) {
       return get(/databases/$(database)/documents/userCondominios/$(uid)/vinculos/$(condominioId)).data;
    }

    function isMoradorAtivo(condominioId) {
        let vinculo = getVinculo(request.auth.uid, condominioId);
        return isSignedIn() && vinculo.role == 'MORADOR' && vinculo.status == 'ATIVO';
    }
    
    // Helper function to check if the user is a resident of a specific unit.
    function isOwnerOfUnidade(condominioId, unidadeId) {
      let vinculo = getVinculo(request.auth.uid, condominioId);
      return isMoradorAtivo(condominioId) && vinculo.unidadeId == unidadeId;
    }

    function isUserInCondo(condominioId) {
      return isCondoStaff(condominioId) || isMoradorAtivo(condominioId);
    }
    
    // --- DATA VALIDATION HELPERS ---
    
    function isValidUnidadeWrite(data) {
       let isVago = data.ocupacao == 'VAGO' && data.proprietarioUid == null && data.inquilinoUid == null && data.responsavelUid == null;
       let isProprietario = data.ocupacao == 'PROPRIETARIO' && data.proprietarioUid != null && data.inquilinoUid == null && data.responsavelUid == data.proprietarioUid;
       let isAlugado = data.ocupacao == 'ALUGADO' && data.proprietarioUid != null && data.inquilinoUid != null && data.responsavelUid == data.inquilinoUid;
       
       return isVago || isProprietario || isAlugado;
    }

    function isMoradorSelfUpdateValid() {
      // Allow user to update only their name and email.
      let allowedKeys = ['nome', 'email'];
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowedKeys);
    }
    
    // =====================================================================
    // USER VINCULOS COLLECTION
    // =====================================================================
    match /userCondominios/{uid} {
      allow read, write: if isSuperAdmin() || isOwner(uid);

      match /vinculos/{condominioId} {
        allow read: if isSuperAdmin() || isOwner(uid);
        allow create: if isSuperAdmin() || isOwner(uid);
        // Only Super Admins or a Sindico of that condo can update a user's role/status.
        allow update: if (isSuperAdmin() || isSindico(condominioId)) && isCreatedAtUnchanged();
        allow delete: if isSuperAdmin() || isSindico(condominioId);
      }
    }

    // =====================================================================
    // CONDOMINIOS COLLECTION
    // =====================================================================
    match /condominios/{condominioId} {
      allow read: if isSuperAdmin() || isUserInCondo(condominioId);
      allow create: if isSuperAdmin();
      allow update: if isSuperAdmin() && isCreatedAtUnchanged();
      allow delete: if isSuperAdmin();

      // --- SUBCOLECTIONS ---

      match /blocos/{blocoId} {
         allow read: if isSuperAdmin() || isUserInCondo(condominioId);
         allow create: if isSuperAdmin() || isSindico(condominioId);
         allow update: if (isSuperAdmin() || isSindico(condominioId)) && isCreatedAtUnchanged();
         allow delete: if isSuperAdmin(); // Only super admins can delete structural elements.
      }

      match /blocos/{blocoId}/unidades/{unidadeId} {
         allow read: if isSuperAdmin() || isUserInCondo(condominioId);
         allow create: if (isSuperAdmin() || isSindico(condominioId)) && isValidUnidadeWrite(request.resource.data);
         allow update: if (isSuperAdmin() || isSindico(condominioId)) && isValidUnidadeWrite(request.resource.data) && isCreatedAtUnchanged();
         allow delete: if isSuperAdmin(); // Only super admins can delete structural elements.
      }

      match /blocos/{blocoId}/unidades/{unidadeId}/moradores/{moradorUid} {
          // Staff can read all residents. A resident can only read other residents of their own unit.
          allow read: if isSuperAdmin() || isCondoStaff(condominioId) || isOwnerOfUnidade(condominioId, unidadeId);
          allow create, delete: if isSuperAdmin() || isSindico(condominioId);
          // A user can update their own profile (name/email), or a Sindico/SuperAdmin can update anything.
          allow update: if (isSuperAdmin() || isSindico(condominioId) || (isOwner(moradorUid) && isMoradorSelfUpdateValid())) && isCreatedAtUnchanged();
      }
      
      match /blocos/{blocoId}/unidades/{unidadeId}/veiculos/{veiculoId} {
          allow read: if isSuperAdmin() || isCondoStaff(condominioId) || isOwnerOfUnidade(condominioId, unidadeId);
          allow create: if isSuperAdmin() || isSindico(condominioId) || (isMoradorAtivo(condominioId) && request.resource.data.ownerUid == request.auth.uid);
          // A resident can only update their own vehicle, and cannot change the owner.
          allow update: if (isSuperAdmin() || isSindico(condominioId) || (isMoradorAtivo(condominioId) && resource.data.ownerUid == request.auth.uid)) && request.resource.data.ownerUid == resource.data.ownerUid;
          allow delete: if isSuperAdmin() || isSindico(condominioId) || (isMoradorAtivo(condominioId) && resource.data.ownerUid == request.auth.uid);
      }
      
       match /blocos/{blocoId}/unidades/{unidadeId}/pets/{petId} {
          // Leitura com privacidade por unidade
          allow read: if isSuperAdmin()
                      || isCondoStaff(condominioId)
                      || isOwnerOfUnidade(condominioId, unidadeId);

          // Criação
          allow create: if isSuperAdmin()
                        || isSindico(condominioId)
                        || (isMoradorAtivo(condominioId)
                            && request.resource.data.ownerUid == request.auth.uid);

          // Atualização (sem trocar o dono)
          allow update: if (isSuperAdmin()
                            || isSindico(condominioId)
                            || (isMoradorAtivo(condominioId)
                                && resource.data.ownerUid == request.auth.uid))
                        && request.resource.data.ownerUid == resource.data.ownerUid;

          // Exclusão
          allow delete: if isSuperAdmin()
                        || isSindico(condominioId)
                        || (isMoradorAtivo(condominioId)
                            && resource.data.ownerUid == request.auth.uid);
      }
      
      match /membros/{membroUid} {
         allow read: if isSuperAdmin() || isUserInCondo(condominioId);
         allow create: if isSuperAdmin() || isSindico(condominioId);
         allow update: if (isSuperAdmin() || isSindico(condominioId)) && isCreatedAtUnchanged();
         // Sindico can only delete Porteiros. SuperAdmin can delete anyone. Avoids a sindico locking themselves out.
         allow delete: if isSuperAdmin() || (isSindico(condominioId) && resource.data.role != 'SINDICO');
      }

      match /funcionarios/{funcionarioId} {
        allow read: if isSuperAdmin() || isCondoStaff(condominioId);
        allow write: if isSuperAdmin() || isSindico(condominioId);
      }

      match /fornecedores/{fornecedorId} {
        allow read: if isSuperAdmin() || isCondoStaff(condominioId);
        allow write: if isSuperAdmin() || isSindico(condominioId);
      }
      
      match /config/{docId} {
        allow read: if isSuperAdmin() || isUserInCondo(condominioId);
        allow write: if isSuperAdmin() || isSindico(condominioId);
      }

      // --- MODULES (Anuncios, Reservas, etc.) ---
      match /{module}/{moduleId} {
        allow read: if isSuperAdmin() || isUserInCondo(condominioId);
        
        // Granular write permissions for modules
        allow write: if isSuperAdmin() ||
                      isSindico(condominioId) ||
                      (isPorteiro(condominioId) && (module == 'encomendas' || module == 'incidentes')) ||
                      (isMoradorAtivo(condominioId) && (module == 'reservas' || module == 'incidentes'));
      }
    }
  }
}
