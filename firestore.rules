
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------
    // Helpers Globais
    // -------------------------
    function signedIn() {
      return request.auth != null;
    }

    function isSuper() {
          return signedIn() && (
            request.auth.token.super_admin == true ||
            request.auth.token.superAdmin == true ||
            (
              (request.auth.token.role == null ? "" : request.auth.token.role).upper() == "SUPER_ADMIN"
            ) ||
            (
              request.auth.token.roles is list &&
              request.auth.token.roles.hasAny(["SUPER_ADMIN"])
            )
          );
        }
function memberPath(condominioId) {
      return /databases/$(database)/documents/condominios/$(condominioId)/membros/$(request.auth.uid);
    }

    function hasMember(condominioId) {
      return signedIn() && exists(memberPath(condominioId));
    }

    function membroData(condominioId) {
      return get(memberPath(condominioId)).data;
    }

    function isMembroAtivo(condominioId) {
      return hasMember(condominioId) && (membroData(condominioId).status == null ? "" : membroData(condominioId).status).upper() == "ATIVO";
    }

    function role(condominioId) {
      return (membroData(condominioId).role == null ? "" : membroData(condominioId).role).upper();
    }
    
    
    // Morador só pode autorizar acesso para o PRÓPRIO destino (unidade/bloco do vínculo)
    function mesmoDestinoDoMorador(condominioId, acessoData) {
      let m = membroData(condominioId);

      // Unidade precisa bater sempre
      let unidadeOk = (m.unidadeId == acessoData.unidadeId);

      // Se o acesso tiver bloco, precisa bater; se não tiver bloco, aceita
      let blocoOk = (acessoData.blocoId == null) || (m.blocoId == acessoData.blocoId);

      return unidadeOk && blocoOk;
    }

function isOperador(condominioId) {
      return isMembroAtivo(condominioId) && (role(condominioId) in ["SINDICO","ADMIN","ADMIN_CONDOMINIO","SUPER_ADMIN"]);
    }
    
    function isPortaria(condominioId) {
        return isMembroAtivo(condominioId) && (role(condominioId) in ["PORTEIRO","SEGURANCA"]);
    }

    function isPortariaOrOperador(condominioId) {
      return isOperador(condominioId) || isPortaria(condominioId);
    }

    // aliases usados em outras partes das rules (mantém compatibilidade do projeto)
    function canManageCondo(condominioId) {
      return isSuper() || isOperador(condominioId);
    }

    function isPorteiro(condominioId) {
      return isMembroAtivo(condominioId) && role(condominioId) == "PORTEIRO";
    }

    function isMorador(condominioId) {
      return isMembroAtivo(condominioId) && role(condominioId) == "MORADOR";
    }

    function isZelador(condominioId) {
      return isMembroAtivo(condominioId) && role(condominioId) == 'ZELADOR';
    }

    // -------------------------
    // Coleções Globais
    // -------------------------
    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid;
      allow delete: if isSuper();

      match /fcmTokens/{tokenId} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow create, update: if signedIn() && request.auth.uid == uid;
        allow delete: if signedIn() && request.auth.uid == uid;
      }
    }

    match /userCondominios/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if isSuper();

      match /vinculos/{condominioId} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow write: if isSuper();
      }
    }

    match /condominiosPublicos/{id} {
      allow read: if signedIn();
      allow write: if isSuper();
    }

    // ── G1.6.1 — CLIENTE GLOBAL (Painel Global Treetech) ──
    // Entidade comercial, separada de Condomínio. Acesso exclusivo SUPER_ADMIN,
    // sem papel tenant-scoped. Exclusão negada nesta fase (ver G1.6 — Etapa 5).
    match /globalClientes/{clienteId} {
      allow read: if isSuper();
      allow create, update: if isSuper();
      allow delete: if false;
    }

    // ── G1.6.5 — EMPRESA GLOBAL (Painel Global Treetech) ──
    // Fundação da entidade Empresa, mesmo padrão de acesso de globalClientes.
    // Ainda sem nenhum relacionamento com Cliente/Condomínio/Produto. Exclusão
    // negada nesta fase.
    match /globalEmpresas/{empresaId} {
      allow read: if isSuper();
      allow create, update: if isSuper();
      allow delete: if false;
    }

    // ── G1.7 — PRODUTO GLOBAL (Painel Global Treetech) ──
    // Fundação da entidade Produto, mesmo padrão de acesso de globalClientes/
    // globalEmpresas. Sem nenhum relacionamento com Empresa/Cliente/
    // Condomínio nesta fase. Exclusão negada nesta fase.
    match /globalProdutos/{produtoId} {
      allow read: if isSuper();
      allow create, update: if isSuper();
      allow delete: if false;
    }

    // ── G1.7.1 — LICENCIAMENTO GLOBAL (Painel Global Treetech) ──
    // Fundação do relacionamento Empresa ↔ Produto, mesmo padrão de acesso de
    // globalClientes/globalEmpresas/globalProdutos. Sem relacionamento
    // bidirecional (Empresa/Produto não referenciam licenças). Exclusão
    // negada nesta fase.
    match /globalLicencas/{licencaId} {
      allow read: if isSuper();
      allow create, update: if isSuper();
      allow delete: if false;
    }

    // ── G1.7.2 — PLANO GLOBAL (Painel Global Treetech) ──
    // Fundação da entidade Plano, pertencente exclusivamente a um Produto,
    // mesmo padrão de acesso de globalClientes/globalEmpresas/globalProdutos/
    // globalLicencas. Sem relacionamento com Empresa/Cliente/Licença/
    // Assinatura nesta fase. Exclusão negada nesta fase.
    match /globalPlanos/{planoId} {
      allow read: if isSuper();
      allow create, update: if isSuper();
      allow delete: if false;
    }

    // ── G1.7.3 — ASSINATURA GLOBAL (Painel Global Treetech) ──
    // Conecta comercialmente Empresa → Assinatura → Plano → Produto, sem
    // substituir globalLicencas (Licença ≠ Assinatura). Mesmo padrão de
    // acesso das demais entidades globais. Sem relacionamento bidirecional
    // — Empresa/Produto/Plano/Licença não referenciam a lista de
    // assinaturas. Exclusão negada nesta fase.
    match /globalAssinaturas/{assinaturaId} {
      allow read: if isSuper();
      allow create, update: if isSuper();
      allow delete: if false;
    }

    // ── G1.7.5 — CATÁLOGO GLOBAL DE RECURSOS (Painel Global Treetech) ──
    // Catálogo de capacidades por Produto (produtoId), mesmo padrão de
    // acesso das demais entidades globais. Sem concessão/contratação nesta
    // fase (globalRecursosContratados é entidade futura, não implementada).
    // Exclusão negada nesta fase.
    match /globalRecursos/{recursoId} {
      allow read: if isSuper();
      allow create, update: if isSuper();
      allow delete: if false;
    }

    // ── G1.6.1 — AUDITORIA GLOBAL (Painel Global Treetech) ──
    // Append-only. Escrita apenas via Admin SDK (rotas server-side, que ignoram
    // as Rules) — client nunca escreve diretamente.
    match /globalAuditLogs/{logId} {
      allow read: if isSuper();
      allow create, update, delete: if false;
    }

    // -------------------------
    // Condomínios e Subcoleções
    // -------------------------
    match /condominios/{condominioId} {

      allow read: if isSuper() || isMembroAtivo(condominioId);
      allow create, update, delete: if isSuper();
      
      // =========================
      // ACESSOS (visitas/entregas)
      // =========================
      match /acessos/{acessoId} {
        // leitura: operador/portaria veem tudo; morador vê só os dele
        allow read: if isPortariaOrOperador(condominioId)
          || (isMorador(condominioId) && resource.data.moradorUid == request.auth.uid);

        // criação: operador cria qualquer; morador cria apenas pra ele mesmo
        allow create: if isOperador(condominioId)
          || (isMorador(condominioId) && request.resource.data.moradorUid == request.auth.uid);

        // update: portaria/operador podem atualizar; morador só se dono e PENDENTE,
        // e só pode: manter PENDENTE, AUTORIZAR, ou CANCELAR (nunca ENTROU/SAIU/NEGADO)
        
        // update:
        // - portaria/operador podem operar status (entrada/saida/negação etc)
        // - morador: só pode AUTORIZAR ou CANCELAR o próprio acesso e somente se o destino for o dele
        allow update: if isPortariaOrOperador(condominioId)
          || (
            isMorador(condominioId)
            && resource.data.moradorUid == request.auth.uid
            && resource.data.status == "PENDENTE"
            && request.resource.data.status in ["AUTORIZADO", "CANCELADO"]
            && mesmoDestinoDoMorador(condominioId, resource.data)
            && request.resource.data.diff(resource.data).changedKeys().hasOnly([
              "status",
              "autorizadoPorUid", "autorizadoPorNome", "autorizadoEm",
              "canceladoPorUid", "canceladoPorNome", "canceladoEm",
              "updatedAt"
            ])
          );
// delete: operador pode; morador só se dono e PENDENTE
        allow delete: if isOperador(condominioId)
          || (isMorador(condominioId) && resource.data.moradorUid == request.auth.uid && resource.data.status == "PENDENTE");
      }
      
      // --- REGRAS DE MANUTENÇÃO PREVENTIVA ---
      match /manutencaoRotinas/{rotinaId} {
        allow read: if isMembroAtivo(condominioId);
        allow write: if canManageCondo(condominioId);
      }
      
      match /manutencaoExecucoes/{execucaoId} {
          allow read: if isMembroAtivo(condominioId);
          allow create: if canManageCondo(condominioId);
          allow update: if canManageCondo(condominioId) || isZelador(condominioId) || isPorteiro(condominioId);
          allow delete: if canManageCondo(condominioId);
      }

      match /manutencaoFornecedores/{fornecedorId} {
        allow read: if isMembroAtivo(condominioId);
        allow write: if canManageCondo(condominioId);
      }

      // --- REGRAS DE DOCUMENTOS ---
      match /documentos/{docId} {
        allow read: if isSuper() || isMembroAtivo(condominioId);
        allow create, update, delete: if canManageCondo(condominioId);
      }

        // --- REGRAS DE REUNIÕES ---
        match /reunioes/{reuniaoId} {
          allow read: if isSuper() || isMembroAtivo(condominioId);
          allow create, update, delete: if canManageCondo(condominioId);
        }


        // -------------------------
        // ENQUETES E VOTAÇÕES
        // -------------------------
        match /enquetes/{enqueteId} {

          // Leitura: qualquer membro ativo do condomínio
          allow read: if isMembroAtivo(condominioId) || isSuper();

          // Criar enquete: gestor do condomínio
          allow create: if canManageCondo(condominioId);

          // Encerrar/editar enquete: gestor
          // (encerrar usa updateDoc na enquete)
          allow update, delete: if canManageCondo(condominioId)
            || (
              // Permitir apenas update de contadores pelo morador via transaction
              // (totalVotes e updatedAt) e sem mudar status/título/descrição
              isMembroAtivo(condominioId)
              && request.resource.data.diff(resource.data).changedKeys().hasOnly(['totalVotes','updatedAt'])
              && request.resource.data.status == resource.data.status
              && request.resource.data.titulo == resource.data.titulo
              && request.resource.data.descricao == resource.data.descricao
              && request.resource.data.createdAt == resource.data.createdAt
              && request.resource.data.createdByUid == resource.data.createdByUid
              && request.resource.data.createdByNome == resource.data.createdByNome
            );

          // Opções da enquete
          match /opcoes/{opcaoId} {
            allow read: if isMembroAtivo(condominioId) || isSuper();

            // Gestor cria/edita/apaga opções
            allow create, delete: if canManageCondo(condominioId);

            // Update: gestor OU morador apenas incrementando "votes"
            allow update: if canManageCondo(condominioId)
              || (
                isMembroAtivo(condominioId)
                && request.resource.data.diff(resource.data).changedKeys().hasOnly(['votes'])
                && request.resource.data.texto == resource.data.texto
                && request.resource.data.order == resource.data.order
              );
          }

          // Voto único por usuário: votos/{uid}
          match /votos/{uid} {
            // leitura só do próprio voto (se quiser liberar para gestor, dá pra abrir)
            allow read: if signedIn() && request.auth.uid == uid && (isMembroAtivo(condominioId) || isSuper());

            // Criar voto: apenas o próprio uid e se ainda não existir
            allow create: if signedIn()
              && request.auth.uid == uid
              && (isMembroAtivo(condominioId) || isSuper())
              && !exists(/databases/$(database)/documents/condominios/$(condominioId)/enquetes/$(enqueteId)/votos/$(uid))
              && request.resource.data.keys().hasOnly(['opcaoId','createdAt'])
              && request.resource.data.opcaoId is string;

            // Não permitir alterar voto (mantém voto único)
            allow update, delete: if false;
          }
        }


      // -------------------------
      // Áreas Reserváveis
      // - leitura: qualquer membro ativo do condomínio
      // - escrita: admin/síndico (canManageCondo)
      // -------------------------
      match /areasReservaveis/{areaId} {
        allow read: if isSuper() || isMembroAtivo(condominioId);
        allow create, update, delete: if canManageCondo(condominioId);
      }

      match /membros/{uid} {
        allow read: if isSuper()
                    || (signedIn() && request.auth.uid == uid)
                    || canManageCondo(condominioId);

        allow create, delete: if canManageCondo(condominioId);

        // FIX: Consolidado em única regra allow update (era duplicado)
        // Gestor pode atualizar qualquer campo; morador só pode atualizar campos de PIN
        allow update: if canManageCondo(condominioId)
                      || (
                        signedIn()
                        && request.auth.uid == uid
                        && request.resource.data.diff(resource.data).changedKeys()
                           .hasOnly(['encomendaPinHash', 'encomendaPinLast4', 'encomendaPinUpdatedAt', 'updatedAt', 'encomendaPinFailedAttempts'])
                      );
      }

      match /anuncios/{anuncioId} {
        // AN.2: API server-side gerencia leitura. Client SDK só para gestores.
        allow read: if canManageCondo(condominioId);
        allow create, update, delete: if canManageCondo(condominioId);
      }

        // -------------------------
        // Encomendas e Notificações (Privacidade por Unidade)
        // -------------------------
        match /encomendas/{encomendaId} {
          function isMyUnidade() {
            let membro = membroData(condominioId);
            let encomenda = resource.data;
            return membro.unidadeIdNorm == encomenda.unidadeIdNorm &&
                   (encomenda.blocoIdNorm == null || membro.blocoIdNorm == encomenda.blocoIdNorm);
          }

          allow read: if isSuper() || canManageCondo(condominioId) || isPorteiro(condominioId) || isZelador(condominioId)
                      || (isMembroAtivo(condominioId) && isMyUnidade());
          
          allow create: if canManageCondo(condominioId) || isPorteiro(condominioId) || isZelador(condominioId);

          allow update: if canManageCondo(condominioId) || isPorteiro(condominioId) || isZelador(condominioId);

          allow delete: if isSuper() || canManageCondo(condominioId);
        }

        match /notificacoes/{notificacaoId} {
          function isForMe() {
            return signedIn() && resource.data.targetUid == request.auth.uid;
          }
          
          allow read: if isForMe();
          allow create: if canManageCondo(condominioId) || isPorteiro(condominioId) || isZelador(condominioId);
          allow update: if isForMe(); // para marcar como lida
          allow delete: if isForMe();
        }

      // --- REGRAS DE INCIDENTES ---
      match /incidentes/{incidenteId} {
        
        function isOwner() {
          return signedIn() && resource.data.criadoPorUid == request.auth.uid;
        }

        // Leitura: Gestores podem ler tudo. Moradores podem ler apenas os seus (API server-side).
        allow get: if canManageCondo(condominioId) || (isMembroAtivo(condominioId) && isOwner());
        // UN.6D.1: Listagem migrada para API server-side. Client não deve fazer list direto.
        allow list: if false;

        // Escrita: Morador pode criar. Gestores podem criar em nome de outros (via API).
        allow create: if signedIn() && 
                         (request.resource.data.criadoPorUid == request.auth.uid || canManageCondo(condominioId));

        // Update: Gestores podem mudar o status. Dono pode avaliar.
        allow update: if (canManageCondo(condominioId) && 
                         request.resource.data.diff(resource.data).changedKeys().hasOnly(['status', 'updatedAt']))
                      || 
                      (isOwner() && 
                         request.resource.data.diff(resource.data).changedKeys().hasOnly(['avaliacao', 'updatedAt']) &&
                         (resource.data.status == 'RESOLVIDO' || resource.data.status == 'FINALIZADO'));
        
        // Deletar: Apenas gestores.
        allow delete: if canManageCondo(condominioId);

        match /historico/{histId} {
          // Leitura: quem pode ler o incidente, pode ler o histórico.
          allow read: if canManageCondo(condominioId) || isOwner();

          // Escrita: Gestores ou o dono do incidente podem adicionar ao histórico.
          allow create: if canManageCondo(condominioId) || isOwner();
        }
      }

      match /config/{docId} {
        allow read: if isSuper() || isMembroAtivo(condominioId);
        allow write: if canManageCondo(condominioId);
      }

      // --- REGRAS DE COMUNIDADE (Classificados, Achados/Perdidos e Serviços) ---
      match /classificados/{anuncioId} {
        allow read: if isSuper() || isMembroAtivo(condominioId);
        allow create: if isMembroAtivo(condominioId) && request.resource.data.criadoPor == request.auth.uid;
        allow update, delete: if isMembroAtivo(condominioId) && (resource.data.criadoPor == request.auth.uid || canManageCondo(condominioId));
      }

      match /achados-perdidos/{itemId} {
        allow read: if isSuper() || isMembroAtivo(condominioId);
        allow create, update: if isMembroAtivo(condominioId) || isPortariaOrOperador(condominioId);
        allow delete: if canManageCondo(condominioId) || isSuper();
      }

      match /servicos-indicados/{servicoId} {
        allow read: if isSuper() || isMembroAtivo(condominioId);
        allow create: if isMembroAtivo(condominioId) && request.resource.data.indicadoPor == request.auth.uid;
        allow update, delete: if isMembroAtivo(condominioId) && (resource.data.indicadoPor == request.auth.uid || canManageCondo(condominioId));
      }

      // --- REGRAS DE QR CODES DE PORTARIA ---
      match /portariaQrCodes/{qrId} {
        allow read: if isMembroAtivo(condominioId) || isSuper() || isPortariaOrOperador(condominioId);
        allow create: if isMembroAtivo(condominioId) && request.resource.data.criadoPor == request.auth.uid;
        allow update: if isPortariaOrOperador(condominioId) 
                      || (isMembroAtivo(condominioId) && resource.data.criadoPor == request.auth.uid);
        allow delete: if isMembroAtivo(condominioId) && resource.data.criadoPor == request.auth.uid;
      }

      // --- REGRAS DE FINANCEIRO ---
      match /financeiro/{cobrancaId} {
        allow read: if isSuper() || canManageCondo(condominioId);
        allow create, delete: if canManageCondo(condominioId);
        // Confirmação de pagamento só por backend administrativo (ou futuro webhook).
        // MORADOR não pode alterar status/paidAt/paymentMethod diretamente.
        allow update: if canManageCondo(condominioId);
      }

      // --- REGRAS DE WHATSAPP LOGS ---
      match /whatsappLogs/{logId} {
        allow read, write: if canManageCondo(condominioId) || isSuper();
      }

      // --- REGRAS DE PROCURAÇÕES ---
      match /procuracoes/{procId} {
        allow read: if isMembroAtivo(condominioId) || isSuper();
        allow create: if isMembroAtivo(condominioId) && (request.resource.data.outorganteUid == request.auth.uid || canManageCondo(condominioId));
        allow update: if isMembroAtivo(condominioId) && (resource.data.outorganteUid == request.auth.uid || canManageCondo(condominioId));
        allow delete: if canManageCondo(condominioId) || (isMembroAtivo(condominioId) && resource.data.outorganteUid == request.auth.uid);
      }


      // --- BLOCOS E UNIDADES ---
      match /blocos/{blocoId} {
        allow read: if isSuper() || isMembroAtivo(condominioId);
        allow write: if canManageCondo(condominioId);

        match /unidades/{unidadeId} {
          allow read: if isSuper() || isMembroAtivo(condominioId);
          allow write: if canManageCondo(condominioId);

          match /veiculos/{veiculoId} {
            allow read: if isSuper() || isMembroAtivo(condominioId);
            allow write: if canManageCondo(condominioId) || (
              isMembroAtivo(condominioId)
              && membroData(condominioId).blocoId == blocoId
              && (
                (membroData(condominioId).unitDocId != null && membroData(condominioId).unitDocId == unidadeId)
                || (membroData(condominioId).unitDocId == null && membroData(condominioId).unidadeId == unidadeId)
              )
            );
          }

          match /pets/{petId} {
            allow read: if isSuper() || isMembroAtivo(condominioId);
            allow write: if canManageCondo(condominioId) || (
              isMembroAtivo(condominioId)
              && membroData(condominioId).blocoId == blocoId
              && (
                (membroData(condominioId).unitDocId != null && membroData(condominioId).unitDocId == unidadeId)
                || (membroData(condominioId).unitDocId == null && membroData(condominioId).unidadeId == unidadeId)
              )
            );
          }

          match /consumo/{consumoId} {
            allow read: if isSuper() || isMembroAtivo(condominioId);
            allow write: if canManageCondo(condominioId);
          }
        }

        match /ramais/{ramalId} {
          allow read: if isSuper() || isMembroAtivo(condominioId);
          allow write: if canManageCondo(condominioId);
        }
      }

      // --- FUNCIONARIOS E FORNECEDORES ---
      match /funcionarios/{funcionarioId} {
        allow read: if isSuper() || isMembroAtivo(condominioId);
        allow write: if canManageCondo(condominioId);
      }

      match /fornecedores/{fornecedorId} {
        allow read: if isSuper() || isMembroAtivo(condominioId);
        allow write: if canManageCondo(condominioId);
      }

      // --- REGRAS DE TREEMIDIA ---
      match /treemidia_telas/{telaId} {
        allow read: if isSuper() || isMembroAtivo(condominioId);
        allow create, update, delete: if isSuper() || canManageCondo(condominioId);
      }
      match /treemidia_campanhas/{campanhaId} {
        allow read: if isSuper() || isMembroAtivo(condominioId);
        allow create, update, delete: if isSuper() || canManageCondo(condominioId);
      }
      match /treemidia_playlists/{playlistId} {
        allow read: if isSuper() || isMembroAtivo(condominioId);
        allow create, update, delete: if isSuper() || canManageCondo(condominioId);
      }

      // --- REGRAS DE RESERVAS E CONVIDADOS ---
      match /reservas/{reservaId} {
        function isOwner() {
            let r = resource.data;
            return signedIn() && (
              r.uid == request.auth.uid ||
              r.userId == request.auth.uid ||
              r.moradorUid == request.auth.uid ||
              r.createdByUid == request.auth.uid ||
              (r.createdBy != null && r.createdBy.uid == request.auth.uid)
            );
          }

        allow read: if isMembroAtivo(condominioId) || isSuper();

        allow create: if isMembroAtivo(condominioId)
                      && request.resource.data.uid == request.auth.uid;
        
        // MORADOR não pode alterar reservas diretamente (nem para CANCELADA).
        // Cancelamento é exclusivamente via /api/reservas/cancelar (Admin SDK),
        // que aplica prazo/48h, slot, fila, notificações e auditoria.
        allow update: if canManageCondo(condominioId)
                      || (
                           isPorteiro(condominioId) &&
                           request.resource.data.diff(resource.data).changedKeys()
                             .hasOnly(['statusAcesso', 'entradaEm', 'porteiroUid', 'updatedAt'])
                         );

        allow delete: if isSuper() || canManageCondo(condominioId);

        match /convidados/{convidadoId} {
            function getReservaDoc() {
              return get(/databases/$(database)/documents/condominios/$(condominioId)/reservas/$(reservaId));
            }

            function isParentReservaOwner() {
                let reserva = getReservaDoc().data;
                return signedIn() && (
                  reserva.uid == request.auth.uid ||
                  reserva.userId == request.auth.uid ||
                  reserva.moradorUid == request.auth.uid ||
                  reserva.createdByUid == request.auth.uid ||
                  (reserva.createdBy != null && reserva.createdBy.uid == request.auth.uid)
                );
              }

            allow read: if isSuper() || canManageCondo(condominioId) || isParentReservaOwner() ||
                        (isPorteiro(condominioId) && getReservaDoc().data.status == 'APROVADA');

            allow create, delete: if isSuper() || canManageCondo(condominioId) || isParentReservaOwner();
            
            allow update: if canManageCondo(condominioId) ||
                          (isPorteiro(condominioId)
                            && getReservaDoc().data.status == 'APROVADA'
                            && request.resource.data.status == 'ENTROU'
                            && request.resource.data.diff(resource.data).changedKeys()
                                 .hasOnly(['status', 'entradaEm', 'porteiroUid', 'updatedAt']));
          }
      }
      
      // -------------------------
      // Comunicação (Threads / Mensagens)
      // -------------------------
      match /threads/{threadId} {
        allow read: if isSuper() || canManageCondo(condominioId) ||
                    (isMembroAtivo(condominioId) && (
                      resource.data.tipo == "CONDOMINIO" ||
                      (resource.data.toUids is list && request.auth.uid in resource.data.toUids)
                    ));
        allow create, update, delete: if canManageCondo(condominioId);

        match /mensagens/{msgId} {
          allow read: if isSuper() || canManageCondo(condominioId) ||
                      (isMembroAtivo(condominioId) && (
                        get(/databases/$(database)/documents/condominios/$(condominioId)/threads/$(threadId)).data.tipo == "CONDOMINIO" ||
                        (get(/databases/$(database)/documents/condominios/$(condominioId)/threads/$(threadId)).data.toUids is list &&
                         request.auth.uid in get(/databases/$(database)/documents/condominios/$(condominioId)/threads/$(threadId)).data.toUids)
                      ));

          allow create: if canManageCondo(condominioId)
            || (
              isMembroAtivo(condominioId)
              && role(condominioId) == "MORADOR"
              && get(/databases/$(database)/documents/condominios/$(condominioId)/threads/$(threadId)).data.tipo == "MORADOR"
              && get(/databases/$(database)/documents/condominios/$(condominioId)/threads/$(threadId)).data.moradorReplyEnabled == true
              && (
                get(/databases/$(database)/documents/condominios/$(condominioId)/threads/$(threadId)).data.alvo.uid == request.auth.uid
                || get(/databases/$(database)/documents/condominios/$(condominioId)/threads/$(threadId)).data.alvo.uidMorador == request.auth.uid
              )
              && request.resource.data.createdByUid == request.auth.uid
            );

          allow update, delete: if canManageCondo(condominioId);
        }
      }

      // outras subcoleções: leitura p/ membro ativo; escrita p/ admin/síndico
      

        // -------------------------
        // RESERVAS - FILA DE ESPERA (SLOT)
        // reservasSlots/{slotId}/fila/{uid}
        // - slotId: ex: areaId__2026-03-10
        // - fila docId = uid (1 inscrição por pessoa)
        // -------------------------
        match /reservasSlots/{slotId} {
          // leitura do slot: qualquer membro ativo (pra UI saber se tem fila)
          allow read: if isSuper() || isMembroAtivo(condominioId);

          // slot é gerenciado por admin/síndico
          allow create, update, delete: if canManageCondo(condominioId);

                      // lock por UID (impede o mesmo morador reservar 2x no mesmo dia/área)
            match /reservasPorUid/{uid} {
              // admin/síndico vê tudo; morador vê só o próprio
              allow read: if isSuper() || canManageCondo(condominioId) || (signedIn() && request.auth.uid == uid && isMembroAtivo(condominioId));

              // cria lock: só o próprio uid (feito via API, mas fica seguro)
              allow create: if signedIn()
                && isMembroAtivo(condominioId)
                && request.auth.uid == uid
                && request.resource.data.uid == request.auth.uid;

              // update: apenas admin/síndico (se precisar marcar algo)
              allow update: if isSuper() || canManageCondo(condominioId);

              // delete: o próprio pode deletar; admin também
              allow delete: if isSuper() || canManageCondo(condominioId) || (signedIn() && request.auth.uid == uid && isMembroAtivo(condominioId));
            }

match /fila/{uid} {
            // admin/síndico vê tudo; morador vê só o próprio
            allow read: if isSuper() || isMembroAtivo(condominioId);

            // entrar na fila: só o próprio uid
            allow create: if signedIn()
              && isMembroAtivo(condominioId)
              && request.auth.uid == uid
              && request.resource.data.uid == request.auth.uid;

            // update: apenas admin/síndico (pra marcar CHAMADO/EXPIRADO etc)
            allow update: if isSuper() || canManageCondo(condominioId);

            // sair da fila: o próprio pode deletar; admin também
            allow delete: if isSuper() || canManageCondo(condominioId) || (signedIn() && request.auth.uid == uid && isMembroAtivo(condominioId));
          }
        }

      // ── FASE 16.6 / R1 — USO DO CAMPO ──
      match /usoCampo/{registroId} {
        allow read: if isSuper() || isMembroAtivo(condominioId) || isPortaria(condominioId);
        allow create: if false;
        allow update: if false;
        allow delete: if false;

        // ── FASE 16.18 / R6 — CONVIDADOS DO CAMPO ──
        match /convidados/{convidadoId} {
          allow read: if isSuper() || canManageCondo(condominioId)
                      || (isMembroAtivo(condominioId)
                          && get(/databases/$(database)/documents/condominios/$(condominioId)/usoCampo/$(registroId)).data.uid == request.auth.uid);
          allow create, update, delete: if false;
        }
      }

      // ── FASE 16.10 / R2 — CAMPO AGENDA (EXCLUSIVIDADE) ──
      match /campoAgenda/{dateStr} {
        allow read: if isSuper() || isMembroAtivo(condominioId) || isPortaria(condominioId);
        allow create: if false;
        allow update: if false;
        allow delete: if false;
      }

      // ── FASE 16.13 / R4 — BLOQUEIOS ADMINISTRATIVOS ──
      match /bloqueiosReservas/{bloqueioId} {
        allow read: if isSuper() || canManageCondo(condominioId);
        allow create, update, delete: if false;
      }

      // ── FASE 16.14 / R4.1 — COORDENADORES DE CONCORRÊNCIA ──
      match /bloqueiosReservasControle/{targetKey} {
        allow read: if isSuper() || canManageCondo(condominioId);
        allow create, update, delete: if false;
      }

      // ── FASE 16.18 / R6 — LEDGER DE CONVIDADOS ──
      match /convidadosLedger/{ledgerId} {
        allow read: if isSuper() || canManageCondo(condominioId);
        allow create, update, delete: if false;
      }

      // ── FASE 16.18 / R6 — ENTRIES DO LEDGER DE CONVIDADOS ──
      match /convidadosLedgerEntries/{entryId} {
        allow read: if isSuper() || canManageCondo(condominioId);
        allow create, update, delete: if false;
      }

match /{subcollection}/{docId=**} {
        allow read, write: if false;
      }

    }
  }
}
