rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Funções de Ajuda ---

    functionisSignedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isSignedIn() && request.auth.token.super_admin == true;
    }

    // Função para checar se um usuário tem um vínculo ATIVO com um condomínio específico.
    // Esta é a função mais importante para o isolamento dos dados (multi-tenancy).
    function hasActiveLink(condominioId) {
      return isSignedIn() &&
             exists(/databases/$(database)/documents/userCondominios/$(request.auth.uid)/vinculos/$(condominioId)) &&
             get(/databases/$(database)/documents/userCondominios/$(request.auth.uid)/vinculos/$(condominioId)).data.status == 'ATIVO';
    }

    // Função para obter a role de um usuário dentro de um condomínio específico.
    function getRoleInCondo(condominioId) {
      return get(/databases/$(database)/documents/userCondominios/$(request.auth.uid)/vinculos/$(condominioId)).data.role;
    }

    // --- Regras por Coleção ---

    // A coleção `users` é geralmente para dados de perfil público ou que o próprio usuário gerencia.
    // Manterei simples por enquanto.
    match /users/{uid} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == uid;
    }

    // Coleção de vínculos: um usuário só pode acessar seus próprios vínculos.
    match /userCondominios/{uid}/{document=**} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }

    // Coleção pública: qualquer usuário autenticado pode ler a lista de condomínios.
    // Isso é útil para seletores de condomínio no frontend.
    match /condominiosPublicos/{condominioId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin(); // Apenas Super Admin pode adicionar/remover condomínios da lista pública.
    }

    // Coleção principal e privada dos condomínios.
    // Aqui aplicamos as regras de isolamento mais importantes.
    match /condominios/{condominioId} {
      // PERMISSÃO DE LEITURA:
      // Permitido se for Super Admin OU se o usuário tiver um vínculo ATIVO com este condomínio.
      allow read: if isSuperAdmin() || hasActiveLink(condominioId);

      // PERMISSÃO DE ESCRITA:
      // Permitido se for Super Admin OU se o usuário tiver um vínculo ativo E sua role for 'SINDICO'.
      allow write: if isSuperAdmin() || (hasActiveLink(condominioId) && getRoleInCondo(condominioId) == 'SINDICO');

      // REGRAS PARA SUBCOLEÇÕES (Ex: anuncios, reservas, etc.)
      // Esta regra genérica se aplica a todas as subcoleções dentro de um condomínio.
      match /{subcollection}/{docId} {
        // Leitura: Mesma regra do documento pai.
        allow read: if isSuperAdmin() || hasActiveLink(condominioId);

        // Escrita: Super Admin ou Síndico podem escrever.
        // Você pode criar regras mais granulares aqui se um MORADOR puder criar um 'incidente', por exemplo.
        allow write: if isSuperAdmin() || (hasActiveLink(condominioId) && getRoleInCondo(condominioId) == 'SINDICO');
      }
    }
  }
}
