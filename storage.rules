rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() {
      return request.auth != null;
    }

    function membroPath(condId) {
      return /databases/$(database)/documents/condominios/$(condId)/membros/$(request.auth.uid);
    }

    function membroDoc(condId) {
      return firestore.get(membroPath(condId)).data;
    }

    function isMembroAtivo(condId) {
      return signedIn()
        && firestore.exists(membroPath(condId))
        && membroDoc(condId).status == "ATIVO";
    }

    function isOperador(condId) {
      let isSuperClaim = request.auth.token.super_admin == true || request.auth.token.superAdmin == true;
      if (isSuperClaim) {
        return true;
      }
      
      if (!isMembroAtivo(condId)) {
        return false;
      }
      
      let userRole = membroDoc(condId).role;
      return userRole in ["SINDICO", "ADMIN", "ADMIN_CONDOMINIO", "SUPER_ADMIN"];
    }

    match /condominios/{condId}/documentos/{docId}/{fileName} {
      allow read: if isMembroAtivo(condId);
      allow write: if isOperador(condId);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
