rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() {
      return request.auth != null;
    }

    // Super admin: múltiplos formatos de claim suportados
    function isSuper() {
      return signedIn() && (
        request.auth.token.super_admin == true ||
        request.auth.token.superAdmin == true ||
        request.auth.token.role == "SUPER_ADMIN" ||
        (
          request.auth.token.roles is list &&
          request.auth.token.roles.hasAny(["SUPER_ADMIN"])
        )
      );
    }

    // ✅ Storage Rules NÃO tem variável "database". Usa (default).
    // FIX: Usa get() com fallback seguro — se o doc não existir, o campo retorna ""
    function membroDoc(condId) {
      return firestore.get(/databases/(default)/documents/condominios/$(condId)/membros/$(request.auth.uid));
    }

    // FIX: Usa .get() com fallback para evitar erro quando status é null ou doc não existe
    function isMembroAtivo(condId) {
      return signedIn() &&
        membroDoc(condId).data.get('status', '').upper() == "ATIVO";
    }

    function isOperador(condId) {
      let role = membroDoc(condId).data.get('role', '').upper();
      return isMembroAtivo(condId) && (
        role == "ADMIN" ||
        role == "SINDICO" ||
        role == "ADMIN_CONDOMINIO"
      );
    }

    // ------------------------------------------------------------
    // BRANDING GLOBAL
    // Nota: leitura pública intencional (logos do app são assets públicos)
    // para carregamento antes da autenticação (splash screen / login).
    // ------------------------------------------------------------
    match /branding/global/{fileName} {
      // Público — necessário para exibir logo antes do login
      allow read: if true;
      // Escrita: apenas super admin
      allow write: if isSuper();
    }

    // Branding por condomínio
    match /branding/{condId}/{fileName} {
      allow read: if isSuper() || isMembroAtivo(condId);
      allow write: if isSuper() || isOperador(condId);
    }

    // ------------------------------------------------------------
    // ÁREAS COMUNS (imagens das áreas reserváveis)
    // ------------------------------------------------------------
    match /condominios/{condId}/areas/{fileName} {
      allow read: if isSuper() || isMembroAtivo(condId);
      allow write: if isSuper() || isOperador(condId);
    }

    // ------------------------------------------------------------
    // INCIDENTES (fotos das ocorrências)
    // ------------------------------------------------------------
    match /condominios/{condId}/incidentes/{fileName} {
      // UN.6D.1: Restrito a operadores + super admin. API server-side para moradores.
      // SECURITY.P0.11: canManageCondo() não é definida neste arquivo (só
      // isOperador() é) — era uma referência a função inexistente. Corrigido
      // para isOperador(), a função realmente definida e semanticamente
      // equivalente (ADMIN/SINDICO/ADMIN_CONDOMINIO ativos).
      allow read: if isSuper() || isOperador(condId);
      allow write: if isSuper() || isMembroAtivo(condId);
    }

    // ------------------------------------------------------------
    // ENCOMENDAS (fotos de pacotes e entregas)
    // ------------------------------------------------------------
    match /condominios/{condId}/encomendas/{fileName} {
      allow read: if isSuper() || isMembroAtivo(condId);
      allow write: if isSuper() || isMembroAtivo(condId);
    }

    // ------------------------------------------------------------
    // PETS & VEICULOS (fotos de animais e carros)
    // ------------------------------------------------------------
    match /condominios/{condId}/pets/{fileName} {
      allow read: if isSuper() || isMembroAtivo(condId);
      allow write: if isSuper() || isMembroAtivo(condId);
    }
    match /condominios/{condId}/veiculos/{fileName} {
      allow read: if isSuper() || isMembroAtivo(condId);
      allow write: if isSuper() || isMembroAtivo(condId);
    }

    // ------------------------------------------------------------
    // DOCUMENTOS
    // ------------------------------------------------------------
    match /condominios/{condId}/documentos/{docId}/{fileName} {
      allow read: if isSuper() || isMembroAtivo(condId);
      allow write: if isSuper() || isOperador(condId);
    }

    // ------------------------------------------------------------
    // TREEMIDIA — Campanhas (multi-tenant)
    // ------------------------------------------------------------
    match /condominios/{condId}/treemidia/campanhas/{campanhaId}/{fileName} {
      // Leitura pública — necessária para exibição nas telas digitais (kiosk)
      allow read: if true;
      allow write: if isSuper() || isOperador(condId);
    }

    // TREEMIDIA — Path legado (somente leitura, sem escrita)
    match /treemidia/campanhas/{campanhaId}/{fileName} {
      allow read: if true;
      allow write: if false;
    }

    // ------------------------------------------------------------
    // Default deny — bloqueia qualquer outro path não declarado
    // ------------------------------------------------------------
    match /{path=**} {
      allow read, write: if false;
    }
  }
}
