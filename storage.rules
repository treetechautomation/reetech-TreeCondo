rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // --- FUNÇÕES DE APOIO (CROSS-SERVICE) ---

    function signedIn() {
      return request.auth != null;
    }

    function isSuper() {
      return signedIn() && (
        request.auth.token.super_admin == true ||
        request.auth.token.superAdmin == true
      );
    }

    function getMembroDoc(condId) {
      return firestore.get(/databases/$(database)/documents/condominios/$(condId)/membros/$(request.auth.uid));
    }

    function isMembroAtivo(condId) {
      return signedIn() &&
             exists(/databases/$(database)/documents/condominios/$(condId)/membros/$(request.auth.uid)) &&
             getMembroDoc(condId).data.status == "ATIVO";
    }

    function isOperador(condId) {
      let role = getMembroDoc(condId).data.role;
      return isMembroAtivo(condId) &&
        (role == "ADMIN" || role == "SINDICO" || role == "ADMIN_CONDOMINIO");
    }

    // ============================================================
    // BRANDING
    // ============================================================

    // Global: logo do menu TreeCondo (qualquer um logado pode ver)
    match /branding/global/{fileName} {
      allow read: if signedIn();
      allow write: if isSuper(); // Apenas Super Admin pode alterar
    }

    // Por Condomínio: logo do painel (apenas membros ativos)
    match /branding/{condId}/{fileName} {
      allow read: if isSuper() || isMembroAtivo(condId);
      allow write: if isSuper() || isOperador(condId);
    }
    
    // Legado: /condominios/{condId}/branding/* (mesmas regras)
    match /condominios/{condId}/branding/{fileName} {
       allow read: if isSuper() || isMembroAtivo(condId);
       allow write: if isSuper() || isOperador(condId);
    }

    // --- DOCUMENTOS ---
    match /condominios/{condId}/documentos/{docId}/{fileName} {
      allow read: if isMembroAtivo(condId);
      allow write: if isOperador(condId);
    }

    // --- REGRA DE BLOQUEIO PADRÃO ---
    match /{path=**} {
      allow read, write: if false;
    }
  }
}
