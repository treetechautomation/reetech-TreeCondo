rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() {
      return request.auth != null;
    }

    function membroPath(condId) {
      return /databases/$(database)/documents/condominios/$(condId)/membros/$(request.auth.uid);
    }

    function membroDoc(condId) {
      return firestore.get(membroPath(condId));
    }

    function isMembroAtivo(condId) {
      return signedIn()
        && firestore.exists(membroPath(condId))
        && membroDoc(condId).data.status == "ATIVO";
    }

    // Corrigido: adiciona verificação 'signedIn' e simplifica lógica.
    function isOperador(condId) {
      // Regra 1: Deve estar logado
      if (!signedIn()) {
        return false;
      }

      // Regra 2: Super admin pode tudo
      if (request.auth.token.super_admin == true || request.auth.token.superAdmin == true) {
        return true;
      }
      
      // Regra 3: Se não for super admin, precisa ser membro ativo com cargo de gestão
      if (isMembroAtivo(condId)) {
        let userRole = membroDoc(condId).data.role;
        return userRole in ["SINDICO", "ADMIN", "ADMIN_CONDOMINIO"];
      }

      // Se não for super admin e não for membro ativo gestor, nega.
      return false;
    }

    match /condominios/{condId}/documentos/{docId}/{fileName} {
      allow read: if isMembroAtivo(condId);
      allow write: if isOperador(condId);
    }

    // Regra de fallback: nega tudo que não foi permitido explicitamente
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
