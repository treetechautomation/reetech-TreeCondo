import {
  isSignInWithEmailLink,
  sendSignInLinkToEmail,
  signInWithEmailLink,
  type Auth,
} from "firebase/auth";

/**
 * Envia link mágico para e-mail.
 * - Salva o e-mail em localStorage para concluir o login ao clicar no link.
 */
export async function sendMagicLink(auth: Auth, email: string) {
  const url =
    typeof window !== "undefined"
      ? `${window.location.origin}/login`
      : "http://localhost:3000/login";

  const actionCodeSettings = {
    url,
    handleCodeInApp: true,
  };

  await sendSignInLinkToEmail(auth, email, actionCodeSettings);
  if (typeof window !== "undefined") {
    window.localStorage.setItem("treecondo_magic_email", email);
  }
}

/**
 * Se a URL atual for um link mágico, conclui o login.
 * Retorna o userCredential.user se concluir, senão null.
 */
export async function completeMagicLink(auth: Auth) {
  if (typeof window === "undefined") return null;

  const href = window.location.href;
  if (!isSignInWithEmailLink(auth, href)) return null;

  let email = window.localStorage.getItem("treecondo_magic_email") || "";
  if (!email) {
    // fallback se abriu em outro navegador/celular
    email = window.prompt("Confirme seu e-mail para concluir o login:") || "";
  }
  if (!email) return null;

  const cred = await signInWithEmailLink(auth, email, href);

  // limpa para evitar reaproveitar
  window.localStorage.removeItem("treecondo_magic_email");

  return cred.user;
}
