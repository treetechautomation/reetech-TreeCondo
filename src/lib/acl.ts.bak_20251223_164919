import type { Session } from "@/hooks/useSession";

export type Role = "SUPER_ADMIN" | "ADMIN" | "SINDICO" | "PORTEIRO" | "MORADOR";

/**
 * ACL simples e compatível com o modelo atual do projeto:
 * - super admin: session.superAdmin === true  (ou compat via any)
 * - super admin por e-mail (regra extra do front)
 * - role do vínculo ativo: session.activeVinculo?.role (compat via any)
 */
export function hasRole(session: Session | null, requiredRoles: Role[]): boolean {
  if (!session) return false;

  const email = session.user?.email ?? "";

  // compat: superAdmin pode existir como session.superAdmin ou session.isSuperAdmin (legado)
  const superAdmin =
    (session as any).superAdmin === true ||
    (session as any).isSuperAdmin === true ||
    (session as any).super_admin === true;

  if (superAdmin) return true;

  // regra extra: esse e-mail sempre é SUPER_ADMIN no front
  if (requiredRoles.includes("SUPER_ADMIN") && email === "treecommunity@treetechautomation.com") {
    return true;
  }

  // role atual (vínculo ativo) – compat com nomes diferentes
  const activeVinculo = (session as any).activeVinculo ?? (session as any).vinculoAtivo ?? null;
  const role = activeVinculo?.role as Role | undefined;

  if (!role) return false;

  return requiredRoles.includes(role);
}
