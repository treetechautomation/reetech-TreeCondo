function resolveFirestore(maybe: any) {
  return maybe?.firestore ?? maybe;
}

function moneyBRLFromCentavos(v?: number) {
  const n = Number(v ?? 0) / 100;
  return n.toLocaleString("pt-BR", { style: "currency", currency: "BRL" });
}

function toISODateLocal(d: Date) {
  const y = d.getFullYear();
  const m = String(d.getMonth() + 1).padStart(2, "0");
  const day = String(d.getDate()).padStart(2, "0");
  return `${y}-${m}-${day}`;
}

export default function ReservasPage() {
  const { session, isSessionLoading } = useSessionCtx();
  const condId = session?.activeCondominioId ?? null;
  const role = session?.role ?? null;

  const firestoreRaw = useFirestore();
  const firestore = React.useMemo(() => resolveFirestore(firestoreRaw), [firestoreRaw]);

  const [dateStr, setDateStr] = React.useState(() => toISODateLocal(new Date()));

  const { areas, reservas, loadingAreas, loadingReservas } = useReservas(condId, dateStr);

  const [selectedAreaId, setSelectedAreaId] = React.useState<string | null>(null);
  const selectedArea = React.useMemo(
    () => areas.find((a: any) => a.id === selectedAreaId) ?? null,
    [areas, selectedAreaId]
  );

  const [openOptions, setOpenOptions] = React.useState(false);
  const [selectedOptionByArea, setSelectedOptionByArea] = React.useState<Record<string, AreaOpcao | null>>({});

  const selectedOption = selectedArea?.id ? (selectedOptionByArea[selectedArea.id] ?? null) : null;
  const hasOptions =
    !!selectedArea && Array.isArray((selectedArea as any).opcoes) && ((selectedArea as any).opcoes?.length ?? 0) > 0;

  const valorSelecionadoCentavos = React.useMemo(() => {
    if (!selectedArea) return 0;
    if (selectedOption?.preco != null) return Number(selectedOption.preco) || 0;
    return Number((selectedArea as any).preco) || 0;
  }, [selectedArea, selectedOption]);

  const podeVer = !isSessionLoading && !!session && !!condId;

  const [isChecking, setIsChecking] = React.useState(false);
  const [isCreating, setIsCreating] = React.useState(false);

  async function handleSelecionarArea(areaId: string) {
    setSelectedAreaId(areaId);

    const a = (areas || []).find((x: any) => x.id === areaId) ?? null;
    setSelectedArea(a);

    // ao trocar de área, limpa seleção de opção anterior
    setSelectedOption(null);

    // fecha modal de opções se estiver aberto
    setOpenOptions(false);
  }
}
