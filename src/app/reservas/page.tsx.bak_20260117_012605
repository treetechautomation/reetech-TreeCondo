"use client";

import * as React from "react";
import AppLayout from "@/components/layout/AppLayout";
import { Button } from "@/components/ui/button";
import { useSessionCtx } from "@/contexts/SessionContext";
import { useReservas } from "@/hooks/useReservas";
import { AreaCard } from "@/components/reservas/AreaCard";
import { AreaOptionDialog, type AreaOpcao } from "@/components/reservas/AreaOptionDialog";
import { useFirestore } from "@/firebase";
import { isDiaDisponivelPorArea } from "@/lib/reservasDisponibilidade";

function moneyBRLFromCentavos(v?: number) {
  const n = Number(v ?? 0) / 100;
  return n.toLocaleString("pt-BR", { style: "currency", currency: "BRL" });
}

function toISODateLocal(d: Date) {
  const y = d.getFullYear();
  const m = String(d.getMonth() + 1).padStart(2, "0");
  const day = String(d.getDate()).padStart(2, "0");
  return `${y}-${m}-${day}`;
}

function resolveFirestore(maybe: any) {
  // Alguns projetos retornam { firestore }, outros retornam o firestore direto.
  return maybe?.firestore ?? maybe;
}

export default function ReservasPage() {
  const { session, isSessionLoading } = useSessionCtx();
  const condId = session?.activeCondominioId ?? null;
  const role = session?.role ?? null;

  const firestoreRaw = useFirestore();
  const firestore = React.useMemo(() => resolveFirestore(firestoreRaw), [firestoreRaw]);

  const [dateStr, setDateStr] = React.useState(() => toISODateLocal(new Date()));
  const [areaFilter, setAreaFilter] = React.useState<string | "ALL">("ALL");

  const [selectedAreaId, setSelectedAreaId] = React.useState<string>("ALL");
  const [selectedOptionId, setSelectedOptionId] = React.useState<string | null>(null);
  const [optionOpen, setOptionOpen] = React.useState(false);

  const { areas, reservas, loadingAreas, loadingReservas } = useReservas(condId, dateStr);

  const selectedArea = React.useMemo(() => {
    if (selectedAreaId === "ALL") return null;
    return areas.find((a: any) => a.id === selectedAreaId) ?? null;
  }, [areas, selectedAreaId]);

  const selectedOption: AreaOpcao | null = React.useMemo(() => {
    if (!selectedArea || !selectedOptionId) return null;
    const ops = (selectedArea as any).opcoes ?? [];
    if (!Array.isArray(ops)) return null;
    return (ops.find((o: any) => String(o.id) === String(selectedOptionId)) as any) ?? null;
  }, [selectedArea, selectedOptionId]);

  const valorSelecionado = React.useMemo(() => {
    if (!selectedArea) return 0;
    // taxa única: se tiver opção selecionada, usa o preço da opção; senão usa o preço base da área
    const v = selectedOption?.preco ?? (selectedArea as any).preco ?? 0;
    return Number(v) || 0;
  }, [selectedArea, selectedOption]);

  // ----- Disponibilidade (dia inteiro por área) -----
  const [dispLoading, setDispLoading] = React.useState(false);
  const [disponivel, setDisponivel] = React.useState<boolean | null>(null);
  const [dispReservaId, setDispReservaId] = React.useState<string | null>(null);
  const [dispError, setDispError] = React.useState<string | null>(null);

  React.useEffect(() => {
    let alive = true;

    async function run() {
      setDispError(null);
      setDispReservaId(null);

      if (!condId || !firestore || selectedAreaId === "ALL") {
        setDisponivel(null);
        setDispLoading(false);
        return;
      }

      setDispLoading(true);
      try {
        const r = await isDiaDisponivelPorArea(firestore, condId, selectedAreaId, dateStr);
        if (!alive) return;
        setDisponivel(r.disponivel);
        setDispReservaId(r.reservaId ?? null);
      } catch (e: any) {
        if (!alive) return;
        setDisponivel(null);
        setDispError(e?.message ? String(e.message) : "Erro ao verificar disponibilidade");
      } finally {
        if (!alive) return;
        setDispLoading(false);
      }
    }

    run();
    return () => {
      alive = false;
    };
  }, [condId, firestore, selectedAreaId, dateStr]);

  const reservasFiltradas = React.useMemo(() => {
    if (areaFilter === "ALL") return reservas;
    return reservas.filter((r: any) => r.areaId === areaFilter);
  }, [reservas, areaFilter]);

  const podeVer = !isSessionLoading && !!session && !!condId;

  const hasOptions = !!selectedArea && Array.isArray((selectedArea as any).opcoes) && (selectedArea as any).opcoes.length > 0;

  const canConfirm =
    role === "MORADOR" &&
    !!condId &&
    !!selectedArea &&
    !dispLoading &&
    disponivel === true &&
    (!hasOptions || !!selectedOption);

  return (
    <AppLayout pageTitle="Reservas" headerActions={null}>
      {!podeVer ? (
        <div className="rounded-2xl border bg-card p-6">
          <div className="text-sm text-muted-foreground">Carregando sessão/condomínio...</div>
        </div>
      ) : (
        <div className="space-y-6">
          {/* Top bar */}
          <div className="rounded-2xl border-black/5 bg-white/55 backdrop-blur-xl p-4 flex flex-col gap-3 md:flex-row md:items-center md:justify-between shadow-sm">
            <div className="flex items-center gap-3">
              <div className="text-sm text-muted-foreground">Dia</div>
              <input
                className="h-10 rounded-xl border bg-background px-3 text-sm"
                type="date"
                value={dateStr}
                onChange={(e) => setDateStr(e.target.value)}
              />
            </div>

            <div className="flex items-center gap-2">
              <Button
                variant="default"
                disabled={!canConfirm}
                onClick={() => {
                  // Próximo passo: gravar reserva no Firestore
                  alert("Próximo passo: confirmar (gravar no Firestore).");
                }}
              >
                Confirmar reserva
              </Button>
            </div>
          </div>

          {/* Áreas */}
          <div className="rounded-2xl border-black/5 bg-white/55 backdrop-blur-xl p-4 shadow-sm">
            <div className="flex items-center justify-between">
              <div className="font-semibold">Áreas reserváveis</div>
              <div className="text-xs text-muted-foreground">
                {loadingAreas ? "Carregando..." : `${areas.length} área(s)`}
              </div>
            </div>

            {loadingAreas ? (
              <div className="mt-4 text-sm text-muted-foreground">Buscando áreas...</div>
            ) : areas.length === 0 ? (
              <div className="mt-4 rounded-xl border bg-muted/20 p-4 text-sm">
                <div className="font-medium">Nenhuma área configurada neste condomínio.</div>
                <div className="mt-1 text-muted-foreground">
                  Isso é intencional e permite ter condomínios diferentes sem quebrar o app.
                </div>
              </div>
            ) : (
              <div className="mt-4 flex flex-wrap gap-2">
                <Button
                  variant={areaFilter === "ALL" ? "default" : "secondary"}
                  onClick={() => setAreaFilter("ALL")}
                >
                  Todas
                </Button>

                {areas.map((a: any) => (
                  <AreaCard
                    key={a.id}
                    area={a}
                    selected={selectedAreaId !== "ALL" ? selectedAreaId === a.id : false}
                    onSelect={() => {
                      setSelectedAreaId(a.id);
                      setSelectedOptionId(null);

                      const ops = a?.opcoes ?? [];
                      if (Array.isArray(ops) && ops.length > 0) {
                        setOptionOpen(true);
                      }
                    }}
                  />
                ))}
              </div>
            )}

            {/* Resumo da seleção */}
            <div className="mt-4 rounded-2xl border bg-background/40 px-4 py-3 text-sm">
              <div className="flex flex-col gap-2 md:flex-row md:items-center md:justify-between">
                <div className="min-w-0">
                  <div className="font-medium">Selecionado</div>
                  {!selectedArea ? (
                    <div className="text-muted-foreground">Nenhuma área selecionada</div>
                  ) : (
                    <div className="text-muted-foreground">
                      <span className="font-medium text-foreground">{(selectedArea as any).nome}</span>
                      {selectedOption ? (
                        <>
                          {" "}• {selectedOption.nome}
                        </>
                      ) : null}
                      {" "}• {moneyBRLFromCentavos(valorSelecionado)}
                    </div>
                  )}
                </div>

                <div className="flex items-center gap-2">
                  {selectedArea && hasOptions && (
                    <Button variant="secondary" onClick={() => setOptionOpen(true)}>
                      {selectedOption ? "Trocar opção" : "Escolher opção"}
                    </Button>
                  )}

                  <div className="text-xs">
                    {selectedAreaId === "ALL" ? (
                      <span className="text-muted-foreground">Selecione uma área para checar disponibilidade</span>
                    ) : dispLoading ? (
                      <span className="text-muted-foreground">Verificando disponibilidade...</span>
                    ) : dispError ? (
                      <span className="text-red-600">Erro ao verificar</span>
                    ) : disponivel === true ? (
                      <span className="text-emerald-600 font-semibold">Disponível</span>
                    ) : disponivel === false ? (
                      <span className="text-red-600 font-semibold">
                        Indisponível {dispReservaId ? `(já reservado)` : ""}
                      </span>
                    ) : (
                      <span className="text-muted-foreground">—</span>
                    )}
                  </div>
                </div>
              </div>

              {selectedArea && hasOptions && !selectedOption ? (
                <div className="mt-2 text-xs text-amber-700">
                  Esta área exige escolher uma opção antes de confirmar.
                </div>
              ) : null}
            </div>
          </div>

          {/* Reservas do dia */}
          <div className="rounded-2xl border-black/5 bg-white/55 backdrop-blur-xl p-4 shadow-sm">
            <div className="flex items-center justify-between">
              <div className="font-semibold">Reservas do dia</div>
              <div className="text-xs text-muted-foreground">
                {loadingReservas ? "Carregando..." : `${reservasFiltradas.length} reserva(s)`}
              </div>
            </div>

            {loadingReservas ? (
              <div className="mt-4 text-sm text-muted-foreground">Buscando reservas...</div>
            ) : reservasFiltradas.length === 0 ? (
              <div className="mt-4 rounded-xl border bg-muted/20 p-4 text-sm text-muted-foreground">
                Nenhuma reserva encontrada para este dia.
              </div>
            ) : (
              <div className="mt-4 space-y-2">
                {reservasFiltradas.map((r: any) => (
                  <div key={r.id} className="rounded-xl border p-4 flex flex-col gap-1">
                    <div className="flex flex-wrap items-center justify-between gap-2">
                      <div className="font-medium">
                        Área: <span className="text-muted-foreground">{r.areaId}</span>
                      </div>
                      <div className="text-sm">
                        Status: <span className="font-semibold">{r.status}</span>
                      </div>
                    </div>
                    <div className="text-sm text-muted-foreground">Valor: {moneyBRLFromCentavos(r.valorCobrado)}</div>
                    <div className="text-xs text-muted-foreground">Reserva ID: {r.id} • UID: {r.uid}</div>
                  </div>
                ))}
              </div>
            )}
          </div>

          {/* Modal de opções */}
          <AreaOptionDialog
            open={optionOpen}
            onOpenChange={setOptionOpen}
            area={selectedArea as any}
            selectedOptionId={selectedOptionId}
            onSelectOption={(opt) => {
              setSelectedOptionId(opt.id);
              setOptionOpen(false);
            }}
          />
        </div>
      )}
    </AppLayout>
  );
}
