"use client";

import * as React from "react";
import AppLayout from "@/components/layout/AppLayout";
import { useSession } from "@/hooks/useSession";
import { initializeFirebase } from "@/firebase";
import {
  addDoc,
  collection,
  deleteDoc,
  doc,
  onSnapshot,
  orderBy,
  query,
  serverTimestamp,
  updateDoc,
} from "firebase/firestore";
import { Button } from "@/components/ui/button";
import { Card, CardContent, CardDescription, CardHeader, CardTitle } from "@/components/ui/card";
import { Dialog, DialogContent, DialogDescription, DialogFooter, DialogHeader, DialogTitle } from "@/components/ui/dialog";
import { Input } from "@/components/ui/input";
import { Textarea } from "@/components/ui/textarea";
import { Badge } from "@/components/ui/badge";

type TipoAviso = "AVISO" | "URGENTE" | "INFORMATIVO";

type Anuncio = {
  id: string;
  titulo: string;
  conteudo: string;
  tipo: TipoAviso;
  createdAt?: any;
  createdByUid?: string;
};

const TIPOS: { key: TipoAviso; label: string }[] = [
  { key: "AVISO", label: "Aviso" },
  { key: "INFORMATIVO", label: "Informativo" },
  { key: "URGENTE", label: "Urgente" },
];

function TipoBadge({ tipo }: { tipo: TipoAviso }) {
  const variant =
    tipo === "URGENTE" ? "destructive" : tipo === "INFORMATIVO" ? "secondary" : "default";
  return <Badge variant={variant as any}>{tipo}</Badge>;
}

export default function AnunciosPage() {
  const { session, isSessionLoading } = useSession();
  const condominioId = session?.activeCondominioId ?? null;

  const [items, setItems] = React.useState<Anuncio[]>([]);
  const [loading, setLoading] = React.useState(true);
  const [error, setError] = React.useState<string | null>(null);

  const [open, setOpen] = React.useState(false);
  const [editing, setEditing] = React.useState<Anuncio | null>(null);

  const [titulo, setTitulo] = React.useState("");
  const [conteudo, setConteudo] = React.useState("");
  const [tipo, setTipo] = React.useState<TipoAviso>("AVISO");
  const [saving, setSaving] = React.useState(false);

  React.useEffect(() => {
    if (isSessionLoading) return;
    if (!condominioId) {
      setError("Selecione um condomínio para ver os avisos.");
      setLoading(false);
      return;
    }

    const { firestore } = initializeFirebase();
    const colRef = collection(firestore, "condominios", condominioId, "anuncios");
    const q = query(colRef, orderBy("createdAt", "desc"));

    setLoading(true);
    setError(null);

    const unsub = onSnapshot(
      q,
      (snap) => {
        const list: Anuncio[] = snap.docs.map((d) => {
          const data = d.data() as any;
          return {
            id: d.id,
            titulo: data.titulo ?? "",
            conteudo: data.conteudo ?? "",
            tipo: (data.tipo ?? "AVISO") as TipoAviso,
            createdAt: data.createdAt,
            createdByUid: data.createdByUid,
          };
        });
        setItems(list);
        setLoading(false);
      },
      (e) => {
        setError(e?.message ?? "Falha ao carregar avisos.");
        setLoading(false);
      }
    );

    return () => unsub();
  }, [isSessionLoading, condominioId]);

  function resetForm() {
    setTitulo("");
    setConteudo("");
    setTipo("AVISO");
    setEditing(null);
  }

  function openNew() {
    resetForm();
    setOpen(true);
  }

  function openEdit(a: Anuncio) {
    setEditing(a);
    setTitulo(a.titulo);
    setConteudo(a.conteudo);
    setTipo(a.tipo);
    setOpen(true);
  }

  async function handleSave(e: React.FormEvent) {
    e.preventDefault();
    if (!condominioId) return;

    const t = titulo.trim();
    const c = conteudo.trim();
    if (!t || !c) return;

    setSaving(true);
    try {
      const { firestore } = initializeFirebase();

      if (editing) {
        const ref = doc(firestore, "condominios", condominioId, "anuncios", editing.id);
        await updateDoc(ref, {
          titulo: t,
          conteudo: c,
          tipo,
          updatedAt: serverTimestamp(),
        });
      } else {
        const colRef = collection(firestore, "condominios", condominioId, "anuncios");
        await addDoc(colRef, {
          titulo: t,
          conteudo: c,
          tipo,
          createdAt: serverTimestamp(),
          createdByUid: session?.user?.uid ?? null,
        });
      }

      setOpen(false);
      resetForm();
    } catch (err: any) {
      alert(err?.message ?? "Falha ao salvar aviso.");
    } finally {
      setSaving(false);
    }
  }

  async function handleDelete(a: Anuncio) {
    if (!condominioId) return;
    if (!confirm(`Excluir o aviso "${a.titulo}"?`)) return;

    try {
      const { firestore } = initializeFirebase();
      const ref = doc(firestore, "condominios", condominioId, "anuncios", a.id);
      await deleteDoc(ref);
    } catch (err: any) {
      alert(err?.message ?? "Falha ao excluir aviso.");
    }
  }

  return (
    <AppLayout
      pageTitle="Avisos"
      headerActions={
        <Button onClick={openNew} disabled={!condominioId}>
          Novo aviso
        </Button>
      }
    >
      <Card>
        <CardHeader>
          <CardTitle>Mural do condomínio</CardTitle>
          <CardDescription>
            Avisos e comunicados para os moradores. {condominioId ? "" : "(Selecione um condomínio)"}
          </CardDescription>
        </CardHeader>
        <CardContent>
          {loading && <div className="text-sm text-slate-600">Carregando...</div>}
          {error && <div className="text-sm text-red-600">{error}</div>}

          {!loading && !error && items.length === 0 && (
            <div className="text-sm text-slate-600">Nenhum aviso publicado ainda.</div>
          )}

          <div className="space-y-3">
            {items.map((a) => (
              <div
                key={a.id}
                className="rounded-xl border bg-white/60 backdrop-blur px-4 py-3 shadow-sm"
              >
                <div className="flex items-start justify-between gap-3">
                  <div>
                    <div className="flex items-center gap-2">
                      <div className="text-sm font-semibold text-slate-900">{a.titulo}</div>
                      <TipoBadge tipo={a.tipo} />
                    </div>
                    <div className="mt-1 text-sm text-slate-700 whitespace-pre-line">
                      {a.conteudo}
                    </div>
                  </div>

                  <div className="flex gap-2">
                    <Button variant="secondary" onClick={() => openEdit(a)}>
                      Editar
                    </Button>
                    <Button variant="destructive" onClick={() => handleDelete(a)}>
                      Excluir
                    </Button>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </CardContent>
      </Card>

      <Dialog open={open} onOpenChange={(v) => (setOpen(v), !v ? resetForm() : null)}>
        <DialogContent>
          <DialogHeader>
            <DialogTitle>{editing ? "Editar aviso" : "Novo aviso"}</DialogTitle>
            <DialogDescription>
              Preencha as informações e publique no mural.
            </DialogDescription>
          </DialogHeader>

          <form onSubmit={handleSave} className="space-y-3">
            <div className="space-y-1">
              <label className="text-sm">Título</label>
              <Input value={titulo} onChange={(e) => setTitulo(e.target.value)} placeholder="Ex: Manutenção do elevador" />
            </div>

            <div className="space-y-1">
              <label className="text-sm">Tipo</label>
              <div className="flex flex-wrap gap-2">
                {TIPOS.map((x) => (
                  <Button
                    key={x.key}
                    type="button"
                    variant={tipo === x.key ? "default" : "secondary"}
                    onClick={() => setTipo(x.key)}
                  >
                    {x.label}
                  </Button>
                ))}
              </div>
            </div>

            <div className="space-y-1">
              <label className="text-sm">Mensagem</label>
              <Textarea value={conteudo} onChange={(e) => setConteudo(e.target.value)} rows={6} placeholder="Escreva o aviso..." />
            </div>

            <DialogFooter>
              <Button type="button" variant="secondary" onClick={() => setOpen(false)}>
                Cancelar
              </Button>
              <Button disabled={saving || !titulo.trim() || !conteudo.trim()} type="submit">
                {saving ? "Salvando..." : "Publicar"}
              </Button>
            </DialogFooter>
          </form>
        </DialogContent>
      </Dialog>
    </AppLayout>
  );
}
