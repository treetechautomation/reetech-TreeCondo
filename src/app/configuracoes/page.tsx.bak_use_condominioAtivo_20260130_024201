"use client";

import * as React from "react";
import AppLayout from "@/components/layout/AppLayout";
import { Button } from "@/components/ui/button";
import { Input } from "@/components/ui/input";
import { useSessionCtx } from "@/contexts/SessionContext";

export default function ConfiguracoesPage() {
  const { session, condominioAtivoId } = useSessionCtx();
  const [pin, setPin] = React.useState("");
  const [saving, setSaving] = React.useState(false);
  const [msg, setMsg] = React.useState<string | null>(null);

  async function salvarPin() {
    setMsg(null);
    if (!condominioAtivoId) {
      setMsg("Selecione um condomínio ativo.");
      return;
    }
    if (!pin || pin.trim().length < 4) {
      setMsg("PIN inválido (mínimo 4 dígitos).");
      return;
    }
    setSaving(true);
    try {
      const token = await session?.user?.getIdToken?.();
      if (!token) throw new Error("Sem token.");

      const res = await fetch("/api/configuracoes/pin-encomendas", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          Authorization: `Bearer ${token}`,
        },
        body: JSON.stringify({
          condominioId: condominioAtivoId,
          pin: pin.trim(),
        }),
      });

      const data = await res.json().catch(() => ({}));
      if (!res.ok || !data?.ok) throw new Error(data?.error || "Erro ao salvar PIN.");

      setPin("");
      setMsg("✅ PIN de encomendas salvo com sucesso.");
    } catch (e: any) {
      setMsg(e?.message || "Erro ao salvar.");
    } finally {
      setSaving(false);
    }
  }

  return (
    <AppLayout>
      <div className="max-w-2xl mx-auto space-y-6">
        <div>
          <h1 className="text-2xl font-semibold">Configurações</h1>
          <p className="text-sm text-muted-foreground mt-1">
            Aqui você pode configurar seu PIN pessoal para retirar encomendas quando esquecer o celular.
          </p>
        </div>

        <div className="rounded-xl border bg-card p-5 space-y-4">
          <div>
            <div className="font-medium">PIN de Encomendas</div>
            <div className="text-sm text-muted-foreground">
              O porteiro pode validar sua retirada usando este PIN (sem QR/celular).
            </div>
          </div>

          <div className="grid gap-3">
            <Input
              type="password"
              placeholder="Defina seu PIN (mínimo 4 dígitos)"
              value={pin}
              onChange={(e) => setPin(e.target.value)}
            />
            <Button onClick={salvarPin} disabled={saving}>
              {saving ? "Salvando..." : "Salvar PIN"}
            </Button>
          </div>

          {msg ? <div className="text-sm">{msg}</div> : null}
        </div>
      </div>
    </AppLayout>
  );
}
