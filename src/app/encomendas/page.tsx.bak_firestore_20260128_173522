"use client";

import * as React from "react";
import { PlusCircle, QrCode, PackageCheck, Camera, Clock, History } from "lucide-react";
import { AppLayout } from "@/components/layout/AppLayout";
import { Input } from "@/components/ui/input";
import { Button } from "@/components/ui/button";
import {
  Table, TableBody, TableCell, TableHead, TableHeader, TableRow,
} from "@/components/ui/table";
import {
  Dialog, DialogContent, DialogDescription, DialogFooter, DialogHeader, DialogTitle, DialogTrigger,
} from "@/components/ui/dialog";
import { Label } from "@/components/ui/label";
import { Tabs, TabsContent, TabsList, TabsTrigger } from "@/components/ui/tabs";

import { useSessionCtx } from "@/contexts/SessionContext";
import { useFirestore } from "@/firebase";
import { addDoc, collection, serverTimestamp, updateDoc, doc } from "firebase/firestore";
import { useEncomendas } from "@/hooks/useEncomendas";

function formatDateTimeBR(v: any) {
  if (!v) return "-";
  const d: Date =
    typeof v?.toDate === "function" ? v.toDate()
    : v instanceof Date ? v
    : new Date(v);

  if (Number.isNaN(d.getTime())) return "-";
  return d.toLocaleString("pt-BR");
}

export default function EncomendasPage() {
  const { session, isSessionLoading } = useSessionCtx();
  const condId = session?.activeCondominioId ?? null;
  const role: string | null = (session as any)?.role ?? null;

  const firestore = useFirestore();
  const { items, loading } = useEncomendas(condId);

  // quem pode registrar/confirmar retirada
  const isSuper = Boolean((session as any)?.superAdmin) || String(role || "").toUpperCase() === "SUPER_ADMIN";
  const isAdminLike = role === "SINDICO" || role === "ADMIN" || role === "ADMIN_CONDOMINIO";
  const isPorteiro = role === "PORTEIRO";
  const isZelador = role === "ZELADOR";
  const canManage = !!session && !!condId && (isSuper || isAdminLike || isPorteiro || isZelador);

  const aguardando = React.useMemo(() => (items || []).filter((i: any) => String(i.status || "AGUARDANDO") === "AGUARDANDO"), [items]);
  const historico = React.useMemo(() => (items || []).filter((i: any) => String(i.status || "") === "RETIRADA"), [items]);

  // form
  const [open, setOpen] = React.useState(false);
  const [unidade, setUnidade] = React.useState("");
  const [transportadora, setTransportadora] = React.useState("");
  const [saving, setSaving] = React.useState(false);

  async function registrar() {
    if (!firestore || !condId) return;
    if (!canManage) {
      alert("Sem permissão para registrar encomenda.");
      return;
    }

    const u = unidade.trim();
    const t = transportadora.trim();
    if (!u) return alert("Informe a unidade (ex: Apto 101).");

    setSaving(true);
    try {
      await addDoc(collection(firestore, "condominios", String(condId), "encomendas"), {
        unidade: u,
        transportadora: t || null,
        status: "AGUARDANDO",
        chegadaEm: serverTimestamp(),
        registradoPorUid: session?.user?.uid ?? null,
      });

      setUnidade("");
      setTransportadora("");
      setOpen(false);
      alert("✅ Encomenda registrada.");
    } catch (e) {
      console.error("[encomendas] erro registrar:", e);
      alert("❌ Não consegui registrar. Veja o console.");
    } finally {
      setSaving(false);
    }
  }

  async function marcarRetirada(id: string) {
    if (!firestore || !condId) return;
    if (!canManage) {
      alert("Sem permissão para registrar retirada.");
      return;
    }

    try {
      await updateDoc(doc(firestore, "condominios", String(condId), "encomendas", String(id)), {
        status: "RETIRADA",
        retiradaEm: serverTimestamp(),
        retiradoPorUid: session?.user?.uid ?? null,
        updatedAt: serverTimestamp(),
      });
      alert("✅ Retirada registrada.");
    } catch (e) {
      console.error("[encomendas] erro retirada:", e);
      alert("❌ Não consegui registrar retirada. Veja o console.");
    }
  }

  const HeaderActions = () => (
    <Dialog open={open} onOpenChange={setOpen}>
      <DialogTrigger asChild>
        <Button size="sm" disabled={!canManage}>
          <PlusCircle />
          <span className="hidden sm:inline-block">Registrar Encomenda</span>
        </Button>
      </DialogTrigger>

      <DialogContent className="sm:max-w-[425px]">
        <DialogHeader>
          <DialogTitle>Registrar Nova Encomenda</DialogTitle>
          <DialogDescription>
            Insira os dados da encomenda e registre a chegada (com data/hora).
          </DialogDescription>
        </DialogHeader>

        <div className="grid gap-4 py-4">
          <div className="grid grid-cols-4 items-center gap-4">
            <Label htmlFor="unit" className="text-right">Unidade</Label>
            <Input
              id="unit"
              placeholder="Ex: Apto 101"
              className="col-span-3"
              value={unidade}
              onChange={(e) => setUnidade(e.target.value)}
              disabled={saving}
            />
          </div>

          <div className="grid grid-cols-4 items-center gap-4">
            <Label htmlFor="carrier" className="text-right">Transportadora</Label>
            <Input
              id="carrier"
              placeholder="Ex: Correios, Mercado Livre"
              className="col-span-3"
              value={transportadora}
              onChange={(e) => setTransportadora(e.target.value)}
              disabled={saving}
            />
          </div>

          <div className="grid grid-cols-4 items-center gap-4">
            <Label className="text-right">Foto</Label>
            <div className="col-span-3">
              <Button variant="outline" disabled>
                <Camera className="mr-2" />
                Tirar Foto do Pacote (próximo passo)
              </Button>
            </div>
          </div>
        </div>

        <DialogFooter>
          <Button type="button" onClick={registrar} disabled={saving || !unidade.trim()}>
            <PackageCheck className="mr-2" />
            {saving ? "Registrando..." : "Registrar"}
          </Button>
        </DialogFooter>
      </DialogContent>
    </Dialog>
  );

  const podeVerTela = !isSessionLoading && !!session && !!condId;

  return (
    <AppLayout pageTitle="Gestão de Encomendas" headerActions={<HeaderActions />}>
      {!podeVerTela ? (
        <div className="rounded-2xl border bg-card p-6">
          <div className="text-sm text-muted-foreground">Carregando sessão/condomínio...</div>
        </div>
      ) : (
        <Tabs defaultValue="waiting">
          <TabsList className="mb-4">
            <TabsTrigger value="waiting"><Clock className="mr-2" />Aguardando</TabsTrigger>
            <TabsTrigger value="history"><History className="mr-2" />Histórico</TabsTrigger>
          </TabsList>

          <TabsContent value="waiting">
            <Table>
              <TableHeader>
                <TableRow>
                  <TableHead>Unidade</TableHead>
                  <TableHead>Chegada</TableHead>
                  <TableHead className="hidden md:table-cell">Transportadora</TableHead>
                  <TableHead className="text-right">Ações</TableHead>
                </TableRow>
              </TableHeader>

              <TableBody>
                {loading ? (
                  <TableRow><TableCell colSpan={4} className="text-muted-foreground">Carregando...</TableCell></TableRow>
                ) : aguardando.length === 0 ? (
                  <TableRow><TableCell colSpan={4} className="text-muted-foreground">Nenhuma encomenda aguardando.</TableCell></TableRow>
                ) : (
                  aguardando.map((pkg: any) => (
                    <TableRow key={pkg.id}>
                      <TableCell>{pkg.unidade || "-"}</TableCell>
                      <TableCell>{formatDateTimeBR(pkg.chegadaEm)}</TableCell>
                      <TableCell className="hidden md:table-cell">{pkg.transportadora || "-"}</TableCell>
                      <TableCell className="text-right">
                        <Button
                          variant="outline"
                          size="sm"
                          onClick={() => marcarRetirada(pkg.id)}
                          disabled={!canManage}
                        >
                          <QrCode className="mr-2" />
                          <span className="hidden sm:inline-block">Registrar Retirada</span>
                        </Button>
                      </TableCell>
                    </TableRow>
                  ))
                )}
              </TableBody>
            </Table>
          </TabsContent>

          <TabsContent value="history">
            <Table>
              <TableHeader>
                <TableRow>
                  <TableHead>Unidade</TableHead>
                  <TableHead>Retirada</TableHead>
                  <TableHead className="hidden md:table-cell">Chegada</TableHead>
                </TableRow>
              </TableHeader>

              <TableBody>
                {loading ? (
                  <TableRow><TableCell colSpan={3} className="text-muted-foreground">Carregando...</TableCell></TableRow>
                ) : historico.length === 0 ? (
                  <TableRow><TableCell colSpan={3} className="text-muted-foreground">Nenhuma encomenda no histórico.</TableCell></TableRow>
                ) : (
                  historico.map((pkg: any) => (
                    <TableRow key={pkg.id}>
                      <TableCell>{pkg.unidade || "-"}</TableCell>
                      <TableCell>{formatDateTimeBR(pkg.retiradaEm)}</TableCell>
                      <TableCell className="hidden md:table-cell">{formatDateTimeBR(pkg.chegadaEm)}</TableCell>
                    </TableRow>
                  ))
                )}
              </TableBody>
            </Table>
          </TabsContent>
        </Tabs>
      )}
    </AppLayout>
  );
}
