"use client";

import * as React from "react";
import {
  PlusCircle,
  Paperclip,
  Send,
  MessageSquare,
  Star,
  Clock,
  CheckCircle2,
  ShieldCheck,
} from "lucide-react";

import AppLayout from "@/components/layout/AppLayout";
import { Button } from "@/components/ui/button";
import {
  Dialog,
  DialogContent,
  DialogDescription,
  DialogFooter,
  DialogHeader,
  DialogTitle,
  DialogTrigger,
} from "@/components/ui/dialog";
import { Label } from "@/components/ui/label";
import { Textarea } from "@/components/ui/textarea";
import { Select, SelectContent, SelectItem, SelectTrigger, SelectValue } from "@/components/ui/select";
import { Card, CardContent, CardHeader, CardTitle, CardDescription, CardFooter } from "@/components/ui/card";
import { Badge } from "@/components/ui/badge";
import { Separator } from "@/components/ui/separator";
import { Input } from "@/components/ui/input";

import { useSessionCtx } from "@/contexts/SessionContext";
import { useFirestore } from "@/firebase";
import {
  addDoc,
  collection,
  doc,
  getDoc,
  limit,
  onSnapshot,
  orderBy,
  query,
  serverTimestamp,
  updateDoc,
  where,
} from "firebase/firestore";

type TipoIncidente = "MANUTENCAO" | "RECLAMACAO" | "DUVIDA_SUGESTAO";
type StatusIncidente = "ABERTO" | "EM_ANDAMENTO" | "RESOLVIDO" | "FINALIZADO";

type Incidente = {
  id: string;
  titulo: string;
  descricao: string;
  tipo: TipoIncidente;
  status: StatusIncidente;

  // opcional (se você já tiver no membro/session)
  unidadeId?: string | null;
  blocoId?: string | null;
  unidadeIdNorm?: string | null;
  blocoIdNorm?: string | null;

  criadoPorUid?: string;
  criadoPorNome?: string;
  criadoPorEmail?: string;

  createdAt?: any;
  updatedAt?: any;
  ultimaAtualizacaoEm?: any;
};

type HistItem = {
  id: string;
  tipo: "SISTEMA" | "COMENTARIO";
  autorNome?: string;
  autorUid?: string;
  mensagem: string;
  createdAt?: any;
};

function fmtTS(ts: any) {
  try {
    if (!ts) return "-";
    const d = ts?.toDate ? ts.toDate() : new Date(ts);
    return d.toLocaleString("pt-BR");
  } catch {
    return "-";
  }
}

function tipoBadge(tipo: TipoIncidente) {
  if (tipo === "MANUTENCAO") return <Badge variant="destructive">Manutenção</Badge>;
  if (tipo === "RECLAMACAO") return <Badge variant="secondary">Reclamação</Badge>;
  return <Badge>Dúvida/Sugestão</Badge>;
}

function statusBadge(status: StatusIncidente) {
  if (status === "ABERTO") return <Badge variant="outline"><Clock className="mr-1 h-3 w-3" />Aberto</Badge>;
  if (status === "EM_ANDAMENTO") return <Badge>Em Andamento</Badge>;
  if (status === "RESOLVIDO") return <Badge className="bg-green-600 hover:bg-green-700"><CheckCircle2 className="mr-1 h-3 w-3" />Resolvido</Badge>;
  return <Badge className="bg-slate-700 hover:bg-slate-800"><ShieldCheck className="mr-1 h-3 w-3" />Finalizado</Badge>;
}

export default function IncidentesPage() {
  const firestore = useFirestore();
  const { session, isLoading: isSessionLoading } = useSessionCtx() as any;

  // tenta obter condominio ativo do seu SessionContext
  const condId =
    (session?.condominioAtivoId as string) ||
    (session?.condominioId as string) ||
    (session?.condId as string) ||
    null;

  const uid = session?.uid || session?.user?.uid || null;

  // regra simples de operador (ajuste se você já tem helper)
  const role = (session?.role || session?.papel || session?.tipo || "").toString().toUpperCase();
  const isOperador = ["PORTEIRO", "SINDICO", "ZELADOR", "ADMIN_CONDOMINIO", "ADMIN", "SUPER_ADMIN"].includes(role);
  const isMorador = ["MORADOR"].includes(role) || (!isOperador && !!uid);

  // moradorInfo (unidade/bloco norm) — tentamos ler do membro do condomínio
  const [moradorInfo, setMoradorInfo] = React.useState<{
    unidadeId: string | null;
    blocoId: string | null;
    unidadeIdNorm: string | null;
    blocoIdNorm: string | null;
  } | null>(null);

  const [loading, setLoading] = React.useState(true);
  const [items, setItems] = React.useState<Incidente[]>([]);
  const [openNew, setOpenNew] = React.useState(false);

  const [novoTipo, setNovoTipo] = React.useState<TipoIncidente>("MANUTENCAO");
  const [novoTitulo, setNovoTitulo] = React.useState("");
  const [novoDesc, setNovoDesc] = React.useState("");
  const [savingNew, setSavingNew] = React.useState(false);
  const [errNew, setErrNew] = React.useState<string | null>(null);

  const [openComent, setOpenComent] = React.useState(false);
  const [comentTexto, setComentTexto] = React.useState("");
  const [comentIncidente, setComentIncidente] = React.useState<Incidente | null>(null);
  const [comentLoading, setComentLoading] = React.useState(false);
  const [hist, setHist] = React.useState<HistItem[]>([]);
  const [savingComent, setSavingComent] = React.useState(false);
  const [errComent, setErrComent] = React.useState<string | null>(null);

  // carrega info do morador (para filtrar incidentes da unidade)
  React.useEffect(() => {
    if (isSessionLoading) return;
    if (!firestore || !condId || !uid) {
      setMoradorInfo(null);
      return;
    }

    const ref = doc(firestore, "condominios", condId, "membros", uid);
    getDoc(ref)
      .then((snap) => {
        const d: any = snap.exists() ? snap.data() : null;
        if (!d) return setMoradorInfo(null);
        setMoradorInfo({
          unidadeId: d.unidadeId ?? null,
          blocoId: d.blocoId ?? null,
          unidadeIdNorm: d.unidadeIdNorm ?? null,
          blocoIdNorm: d.blocoIdNorm ?? null,
        });
      })
      .catch(() => setMoradorInfo(null));
  }, [firestore, condId, uid, isSessionLoading]);

  // listener de incidentes
  React.useEffect(() => {
    if (isSessionLoading) return;
    if (!firestore || !condId) return;

    setLoading(true);

    const col = collection(firestore, "condominios", condId, "incidentes");

    let qref: any;

    if (isOperador) {
      qref = query(col, orderBy("ultimaAtualizacaoEm", "desc"), limit(60));
    } else {
      const un = moradorInfo?.unidadeIdNorm;
      const bl = moradorInfo?.blocoIdNorm;

      if (!un) {
        setItems([]);
        setLoading(false);
        return;
      }

      // MVP: filtra por unidade (e bloco se existir)
      if (bl) {
        qref = query(
          col,
          where("unidadeIdNorm", "==", un),
          where("blocoIdNorm", "==", bl),
          orderBy("ultimaAtualizacaoEm", "desc"),
          limit(60)
        );
      } else {
        qref = query(
          col,
          where("unidadeIdNorm", "==", un),
          orderBy("ultimaAtualizacaoEm", "desc"),
          limit(60)
        );
      }
    }

    const unsub = onSnapshot(
      qref,
      (snap) => {
        const arr: Incidente[] = snap.docs.map((d) => ({ id: d.id, ...(d.data() as any) }));
        setItems(arr);
        setLoading(false);
      },
      (err) => {
        console.error("incidentes listener error:", err);
        setItems([]);
        setLoading(false);
      }
    );

    return () => unsub();
  }, [firestore, condId, isOperador, isSessionLoading, moradorInfo]);

  async function criarIncidente() {
    setErrNew(null);
    if (!firestore || !condId || !uid) {
      setErrNew("Sessão/condomínio inválidos.");
      return;
    }
    if (!novoTitulo.trim() || !novoDesc.trim()) {
      setErrNew("Informe Título e Descrição.");
      return;
    }

    setSavingNew(true);
    try {
      const membro = moradorInfo;

      const ref = await addDoc(collection(firestore, "condominios", condId, "incidentes"), {
        titulo: novoTitulo.trim(),
        descricao: novoDesc.trim(),
        tipo: novoTipo,
        status: "ABERTO",

        unidadeId: membro?.unidadeId ?? null,
        blocoId: membro?.blocoId ?? null,
        unidadeIdNorm: membro?.unidadeIdNorm ?? null,
        blocoIdNorm: membro?.blocoIdNorm ?? null,

        criadoPorUid: uid,
        criadoPorNome: session?.nome || session?.displayName || session?.name || session?.email || "Morador",
        criadoPorEmail: session?.email || null,

        createdAt: serverTimestamp(),
        updatedAt: serverTimestamp(),
        ultimaAtualizacaoEm: serverTimestamp(),
      });

      // histórico inicial (SISTEMA)
      await addDoc(collection(firestore, "condominios", condId, "incidentes", ref.id, "historico"), {
        tipo: "SISTEMA",
        mensagem: "Chamado aberto.",
        createdAt: serverTimestamp(),
      });

      setNovoTitulo("");
      setNovoDesc("");
      setNovoTipo("MANUTENCAO");
      setOpenNew(false);
    } catch (e: any) {
      console.error(e);
      setErrNew(e?.message || "Erro ao abrir chamado.");
    } finally {
      setSavingNew(false);
    }
  }

  function abrirComentarios(pkg: Incidente) {
    setComentIncidente(pkg);
    setOpenComent(true);
  }

  // listener do histórico quando abrir modal de comentários
  React.useEffect(() => {
    if (!openComent) return;
    if (!firestore || !condId || !comentIncidente?.id) return;

    setComentLoading(true);
    setHist([]);

    const col = collection(firestore, "condominios", condId, "incidentes", comentIncidente.id, "historico");
    const qref = query(col, orderBy("createdAt", "desc"), limit(30));
    const unsub = onSnapshot(
      qref,
      (snap) => {
        setHist(snap.docs.map((d) => ({ id: d.id, ...(d.data() as any) })));
        setComentLoading(false);
      },
      (err) => {
        console.error("historico listener error:", err);
        setComentLoading(false);
      }
    );

    return () => unsub();
  }, [openComent, firestore, condId, comentIncidente?.id]);

  async function enviarComentario() {
    setErrComent(null);
    if (!firestore || !condId || !uid || !comentIncidente?.id) {
      setErrComent("Sessão/condomínio inválidos.");
      return;
    }
    if (!comentTexto.trim()) {
      setErrComent("Digite um comentário.");
      return;
    }

    setSavingComent(true);
    try {
      await addDoc(collection(firestore, "condominios", condId, "incidentes", comentIncidente.id, "historico"), {
        tipo: "COMENTARIO",
        autorUid: uid,
        autorNome: session?.nome || session?.displayName || session?.name || session?.email || "Usuário",
        mensagem: comentTexto.trim(),
        createdAt: serverTimestamp(),
      });

      await updateDoc(doc(firestore, "condominios", condId, "incidentes", comentIncidente.id), {
        updatedAt: serverTimestamp(),
        ultimaAtualizacaoEm: serverTimestamp(),
      });

      setComentTexto("");
    } catch (e: any) {
      console.error(e);
      setErrComent(e?.message || "Erro ao comentar.");
    } finally {
      setSavingComent(false);
    }
  }

  async function mudarStatus(pkg: Incidente, status: StatusIncidente) {
    if (!firestore || !condId || !isOperador) return;

    try {
      await updateDoc(doc(firestore, "condominios", condId, "incidentes", pkg.id), {
        status,
        updatedAt: serverTimestamp(),
        ultimaAtualizacaoEm: serverTimestamp(),
      });

      await addDoc(collection(firestore, "condominios", condId, "incidentes", pkg.id, "historico"), {
        tipo: "SISTEMA",
        mensagem: `Status alterado para ${status}.`,
        createdAt: serverTimestamp(),
      });
    } catch (e) {
      console.error("mudarStatus erro:", e);
    }
  }

  const HeaderActions = () => (
    <Dialog open={openNew} onOpenChange={setOpenNew}>
      <DialogTrigger asChild>
        <Button size="sm" disabled={!isMorador && !isOperador}>
          <PlusCircle className="mr-2" />
          <span className="hidden sm:inline-block">Abrir Chamado</span>
          <span className="sm:hidden">Abrir</span>
        </Button>
      </DialogTrigger>

      <DialogContent className="sm:max-w-[520px]">
        <DialogHeader>
          <DialogTitle>Abrir Novo Chamado</DialogTitle>
          <DialogDescription>
            Descreva o seu problema ou sugestão. O gestor será notificado.
          </DialogDescription>
        </DialogHeader>

        <div className="grid gap-4 py-4">
          <div className="grid grid-cols-4 items-center gap-4">
            <Label className="text-right">Tipo</Label>
            <Select value={novoTipo} onValueChange={(v) => setNovoTipo(v as any)}>
              <SelectTrigger className="col-span-3">
                <SelectValue placeholder="Selecione o tipo de solicitação" />
              </SelectTrigger>
              <SelectContent>
                <SelectItem value="RECLAMACAO">Reclamação</SelectItem>
                <SelectItem value="MANUTENCAO">Manutenção</SelectItem>
                <SelectItem value="DUVIDA_SUGESTAO">Dúvida/Sugestão</SelectItem>
              </SelectContent>
            </Select>
          </div>

          <div className="grid grid-cols-4 items-center gap-4">
            <Label htmlFor="title" className="text-right">Título</Label>
            <Input
              id="title"
              placeholder="Ex: Lâmpada do corredor queimada"
              className="col-span-3"
              value={novoTitulo}
              onChange={(e) => setNovoTitulo(e.target.value)}
            />
          </div>

          <div className="grid grid-cols-4 items-center gap-4">
            <Label htmlFor="description" className="text-right">Descrição</Label>
            <Textarea
              id="description"
              placeholder="Detalhe o que está acontecendo."
              className="col-span-3"
              value={novoDesc}
              onChange={(e) => setNovoDesc(e.target.value)}
            />
          </div>

          <div className="grid grid-cols-4 items-center gap-4">
            <Label className="text-right">Foto</Label>
            <div className="col-span-3">
              <Button variant="outline" disabled>
                <Paperclip className="mr-2" />
                (MVP) Upload depois
              </Button>
            </div>
          </div>

          {errNew && <div className="text-sm text-red-600">{errNew}</div>}
        </div>

        <DialogFooter>
          <Button type="button" onClick={criarIncidente} disabled={savingNew}>
            <Send className="mr-2" />
            {savingNew ? "Enviando..." : "Enviar Chamado"}
          </Button>
        </DialogFooter>
      </DialogContent>
    </Dialog>
  );

  return (
    <AppLayout pageTitle="Chamados e Incidentes" headerActions={<HeaderActions />}>
      <div className="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
        {loading ? (
          <div className="text-sm text-muted-foreground">Carregando...</div>
        ) : items.length === 0 ? (
          <div className="text-sm text-muted-foreground">Nenhum chamado ainda.</div>
        ) : (
          items.map((it) => (
            <Card key={it.id} className="border-black/5 bg-white/55 backdrop-blur-xl shadow-sm">
              <CardHeader>
                <div className="flex justify-between items-start gap-3">
                  <div className="min-w-0">
                    <CardTitle className="text-lg truncate">{it.titulo}</CardTitle>
                    <CardDescription className="truncate">
                      Aberto por {it.criadoPorNome || "Morador"}
                      {it.unidadeId ? ` (${it.unidadeId})` : ""}
                    </CardDescription>
                  </div>
                  {tipoBadge(it.tipo)}
                </div>
              </CardHeader>

              <CardContent>
                <p className="text-muted-foreground line-clamp-3">{it.descricao}</p>
                <Separator className="my-4" />
                <div className="flex items-center justify-between gap-3">
                  {statusBadge(it.status)}
                  <div className="text-xs text-muted-foreground">
                    Atualizado: {fmtTS(it.ultimaAtualizacaoEm || it.updatedAt || it.createdAt)}
                  </div>
                </div>
              </CardContent>

              <CardFooter className="justify-between gap-2">
                <Button variant="outline" size="sm" onClick={() => abrirComentarios(it)}>
                  <MessageSquare className="mr-2" />
                  Comentar
                </Button>

                {isOperador && (
                  <div className="flex gap-2">
                    <Button variant="outline" size="sm" onClick={() => mudarStatus(it, "EM_ANDAMENTO")}>
                      Em andamento
                    </Button>
                    <Button variant="outline" size="sm" onClick={() => mudarStatus(it, "RESOLVIDO")}>
                      Resolvido
                    </Button>
                    <Button variant="outline" size="sm" onClick={() => mudarStatus(it, "FINALIZADO")}>
                      Finalizar
                    </Button>
                  </div>
                )}

                {!isOperador && it.status === "RESOLVIDO" && (
                  <div className="flex items-center gap-1 text-sm">
                    <span className="text-muted-foreground">Avaliar:</span>
                    <Star className="text-yellow-400 fill-yellow-400" />
                    <Star className="text-yellow-400 fill-yellow-400" />
                    <Star className="text-yellow-400 fill-yellow-400" />
                    <Star className="text-yellow-400 fill-yellow-400" />
                    <Star className="text-muted-foreground" />
                  </div>
                )}
              </CardFooter>
            </Card>
          ))
        )}
      </div>

      {/* Modal comentários */}
      <Dialog open={openComent} onOpenChange={setOpenComent}>
        <DialogContent className="sm:max-w-[720px]">
          <DialogHeader>
            <DialogTitle>Comentários</DialogTitle>
            <DialogDescription>
              {comentIncidente?.titulo || "-"}
            </DialogDescription>
          </DialogHeader>

          <div className="grid gap-3">
            <div className="rounded-lg border bg-white/60 p-3">
              <div className="text-sm font-medium">Histórico</div>
              <div className="mt-2 space-y-2 max-h-[280px] overflow-auto">
                {comentLoading ? (
                  <div className="text-sm text-muted-foreground">Carregando histórico...</div>
                ) : hist.length === 0 ? (
                  <div className="text-sm text-muted-foreground">Sem histórico ainda.</div>
                ) : (
                  hist.map((h) => (
                    <div key={h.id} className="text-sm">
                      <div className="text-xs text-muted-foreground">
                        <b className="text-foreground">{h.tipo === "SISTEMA" ? "Sistema" : (h.autorNome || "Usuário")}</b>
                        {" • "}
                        {fmtTS(h.createdAt)}
                      </div>
                      <div className="text-sm">{h.mensagem}</div>
                    </div>
                  ))
                )}
              </div>
            </div>

            <div className="grid gap-2">
              <Label>Adicionar comentário</Label>
              <Textarea
                value={comentTexto}
                onChange={(e) => setComentTexto(e.target.value)}
                placeholder="Digite aqui..."
              />
              {errComent && <div className="text-sm text-red-600">{errComent}</div>}
            </div>
          </div>

          <DialogFooter>
            <Button type="button" onClick={enviarComentario} disabled={savingComent}>
              <Send className="mr-2" />
              {savingComent ? "Enviando..." : "Enviar comentário"}
            </Button>
          </DialogFooter>
        </DialogContent>
      </Dialog>
    </AppLayout>
  );
}
