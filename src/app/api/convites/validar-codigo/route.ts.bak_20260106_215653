import { NextResponse } from "next/server";
import crypto from "crypto";
import { FieldValue, Timestamp } from "firebase-admin/firestore";
import { adminDb, adminAuth } from "@/lib/firebaseAdmin";

function jsonError(message: string, status = 400) {
  return NextResponse.json({ ok: false, error: message }, { status });
}

function sha256Hex(input: string) {
  return crypto.createHash("sha256").update(input).digest("hex");
}

type Role = "MORADOR" | "SINDICO" | "PORTEIRO" | "FUNCIONARIO";

export async function POST(req: Request) {
  try {
    const body = (await req.json().catch(() => ({}))) as { code?: string; email?: string };

    const code = (body.code || "").trim().toUpperCase();
    if (!/^TC-[A-Z0-9]{8}$/.test(code)) {
      return jsonError("Código inválido. Use o formato: TC-XXXXXXXX", 400);
    }

    const db = adminDb();
    const aauth = adminAuth();

    const codeHash = sha256Hex(code);
    const now = Timestamp.now();

    // 1) Busca convite pelo hash
    const qs = await db
      .collection("convites")
      .where("codigoHash", "==", codeHash)
      .limit(1)
      .get();

    if (qs.empty) return jsonError("Código não encontrado ou inválido.", 404);

    const conviteRef = qs.docs[0].ref;
    const convite = qs.docs[0].data() as any;

    // Expiração (se existir)
    if (convite?.expiresAt?.toMillis && convite.expiresAt.toMillis() < now.toMillis()) {
      return jsonError("Código expirado. Solicite um novo convite.", 410);
    }

    const conviteId = conviteRef.id;
    const condominioId = (convite.condominioId || "").trim();
    const uid = (convite.uidGerado || convite.uid || "").trim();
    const email = (convite.email || body.email || "").toLowerCase().trim();
    const nome = (convite.nome || "").trim();
    const role = (convite.role || convite.tipo || "MORADOR") as Role;

    if (!condominioId) return jsonError("Convite sem condominioId.", 500);
    if (!uid) return jsonError("Convite sem uidGerado/uid.", 500);

    const membroRef = db.collection("condominios").doc(condominioId).collection("membros").doc(uid);
    const userRef = db.collection("users").doc(uid);

    // 2) Transação: marca convite + ativa membro + cria vínculo no users/{uid}
    await db.runTransaction(async (tx) => {
      const conviteSnap = await tx.get(conviteRef);
      const conviteNow = conviteSnap.data() as any;

      // Evita “validar” 2x
      if (conviteNow?.status === "PROCESSADO" || conviteNow?.status === "VALIDADO") {
        // garante que membro esteja ATIVO mesmo assim
        tx.set(
          membroRef,
          { status: "ATIVO", updatedAt: FieldValue.serverTimestamp() },
          { merge: true }
        );
        return;
      }

      tx.set(
        conviteRef,
        {
          status: "VALIDADO",
          validatedAt: FieldValue.serverTimestamp(),
          codigoUsadoAt: FieldValue.serverTimestamp(),
        },
        { merge: true }
      );

      tx.set(
        membroRef,
        {
          status: "ATIVO",
          updatedAt: FieldValue.serverTimestamp(),
          // garante que campos principais existam
          email: email || conviteNow?.email || null,
          nome: nome || conviteNow?.nome || null,
          role: role || "MORADOR",
        },
        { merge: true }
      );

      // vínculo no perfil (SaaS-friendly)
      // Obs: se você preferir “subcollection”, dá pra mudar depois.
      tx.set(
        userRef,
        {
          email: email || null,
          nome: nome || null,
          vinculos: FieldValue.arrayUnion({
            condominioId,
            role: role || "MORADOR",
            blocoId: conviteNow?.blocoId ?? conviteNow?.bloco ?? null,
            unidadeId: conviteNow?.unidadeId ?? conviteNow?.apartamento ?? null,
            status: "ATIVO",
          }),
          updatedAt: FieldValue.serverTimestamp(),
        },
        { merge: true }
      );
    });

    // Opcional: você pode também setar custom claims aqui no futuro.
    // Ex: await aauth.setCustomUserClaims(uid, { ... })

    return NextResponse.json({
      ok: true,
      conviteId,
      condominioId,
      uid,
      status: "VALIDADO",
    });
  } catch (err: any) {
    console.error("[API convites/validar-codigo] erro:", err);
    return jsonError(err?.message || "Erro inesperado", 500);
  }
}
