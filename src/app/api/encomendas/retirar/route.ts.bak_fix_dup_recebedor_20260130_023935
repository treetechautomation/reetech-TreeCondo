      const recebedorCpf = body?.recebedorCpf ? String(body.recebedorCpf).trim() : "";
      const recebedorParentesco = body?.recebedorParentesco ? String(body.recebedorParentesco).trim() : "";

    // opcional: quando for retirada sem celular, você pode mandar info do recebedor
    const recebedorNome = body?.recebedorNome ? String(body.recebedorNome).trim() : "";
    const recebedorCpf = body?.recebedorCpf ? String(body.recebedorCpf).trim() : "";
    const recebedorParentesco = body?.recebedorParentesco ? String(body.recebedorParentesco).trim() : "";

    // opcional: se o porteiro selecionar o morador que está retirando (melhor!)
    const moradorUid = body?.moradorUid ? String(body.moradorUid).trim() : "";

    if (!condominioId) return jsonError("condominioId é obrigatório", 400);
    if (!encomendaId) return jsonError("encomendaId é obrigatório", 400);
    if (!codigo && !pin && !(moradorUid && pinMorador)) {
        return jsonError("Informe o código (PKG-...), ou o PIN do pacote, ou o PIN do morador (sem celular).", 400);
      }

    const ref = db.collection("condominios").doc(condominioId).collection("encomendas").doc(encomendaId);
    const snap = await ref.get();
    if (!snap.exists) return jsonError("Encomenda não encontrada.", 404);

    const data = snap.data() as any;
    if (String(data?.status || "") === "RETIRADA") {
      return jsonError("Essa encomenda já foi retirada.", 400);
    }

    // validação do código
    const okCodigo = codigo ? sha256(codigo) === String(data?.codigoRetiradaHash || "") : false;

    // validação do PIN (prioridade: PIN do morador selecionado, senão fallback pinHash do doc encomenda)
    let okPin = false;

    if (pin) {
      const pinDigits = pin.replace(/\D/g, "");
      const pinHash = sha256(pinDigits);

      if (moradorUid) {
        const mref = db.collection("condominios").doc(condominioId).collection("membros").doc(moradorUid);
        const msnap = await mref.get();
        const mh = msnap.exists ? String(msnap.data()?.encomendaPinHash || "") : "";
        if (mh && mh === pinHash) okPin = true;
      }

      // fallback: valida pelo pinHash antigo do doc encomenda (MVP antigo)
      if (!okPin && String(data?.pinHash || "")) {
        okPin = pinHash === String(data?.pinHash || "");
      }
    }

    if (!okCodigo && !okPin && !okMoradorPin) {
        return jsonError("Código/PIN inválido.", 403);
      }

    // Registrado por = porteiro (quem fez a operação)
    const registradoPorUid = decoded.uid;
    const registradoPorNome = (decoded.name || decoded.email || "Porteiro").toString();

    // Retirada por = recebedor (morador/terceiro)
    // Se veio moradorUid e você quiser o nome real do morador, puxa do membros
    let retiradaRecebedorUid: string | null = null;
    let retiradaRecebedorNome = recebedorNome || "Não informado";
    let retiradaRecebedorTipo: "MORADOR" | "TERCEIRO" = recebedorNome ? "TERCEIRO" : "MORADOR";

    if (moradorUid) {
      const mref = db.collection("condominios").doc(condominioId).collection("membros").doc(moradorUid);
      const msnap = await mref.get();
      if (msnap.exists) {
        const md = msnap.data() as any;
        retiradaRecebedorUid = moradorUid;
        retiradaRecebedorNome = String(md?.nome || md?.name || md?.email || "Morador").trim();
        retiradaRecebedorTipo = "MORADOR";
      }
    }

    // CPF: não salvar puro (sensível). Salva hash + last4
    const cpfDigits = recebedorCpf.replace(/\D/g, "");
    const retiradaRecebedorCpfHash = cpfDigits ? sha256(cpfDigits) : null;
    const retiradaRecebedorCpfLast4 = cpfDigits ? cpfDigits.slice(-4) : null;

    await db.runTransaction(async (tx) => {
      tx.update(ref, {
        status: "RETIRADA",
        retiradaEm: FieldValue.serverTimestamp(),
        updatedAt: FieldValue.serverTimestamp(),

        // registrado por (porteiro)
        registradoPorUid,
        registradoPorNome,

        // recebedor (quem levou)
        retiradaRecebedorUid: retiradaRecebedorUid ?? null,
        retiradaRecebedorNome,
        retiradaRecebedorTipo,
        retiradaRecebedorParentesco: recebedorParentesco || null,
        retiradaRecebedorCpfHash,
        retiradaRecebedorCpfLast4,

        // mantém campos antigos por compat (se a UI ainda usa)
        retiradoPorUid: registradoPorUid,
        retiradoPorNome: registradoPorNome,
      });

      // notifica todos da unidade
      const title = "✅ Encomenda retirada";
      const message = `Sua encomenda da ${data.transportadora || "transportadora"} foi retirada por ${retiradaRecebedorNome}.`;

      // (depois o create já está salvando unidadeIdNorm/blocoIdNorm, aqui usamos os campos originais)
      // usa blocoId do doc encomenda se existir
      // NOTE: data.blocoId pode estar null
      // unidadeId também pode ter "apto 203" etc, mas notifyUnidade já normaliza.
      // ok.
      // notificação: 1 doc por morador (targetUid)
      // fora da transaction (mas aqui pode ficar dentro também; melhor fora para simplicidade)
      // => então só registra depois da tx
    });

    // fora da transaction: escreve notificações
    try {
      await notifyUnidade(db, {
        condominioId,
        unidadeId: String(data?.unidadeId || ""),
        blocoId: data?.blocoId ?? null,
        tipo: "ENCOMENDA_RETIRADA",
        title: "✅ Encomenda retirada",
        message: `Sua encomenda da ${data?.transportadora || "transportadora"} foi retirada por ${retiradaRecebedorNome}.`,
        encomendaId,
      });
    } catch (e: any) {
      console.error("[encomendas/retirar] falha ao notificar:", e?.message || e);
    }

    return NextResponse.json({ ok: true });
  } catch (err: any) {
    console.error("[API encomendas/retirar] erro:", err);
    return jsonError(err?.message || "Erro inesperado", 500);
  }
}
