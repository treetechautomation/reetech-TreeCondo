"use client";

import React from "react";
import { usePathname, useRouter } from "next/navigation";
import Link from "next/link";

import { cn } from "@/lib/utils";
import { useCondominio } from "@/contexts/CondominioContext";
import { useSessionCtx } from "@/contexts/SessionContext";
import { Button } from "@/components/ui/button";

type AppLayoutProps = {
  pageTitle?: string;
  children: React.ReactNode;
};

const menuItems = [
  { href: "/", label: "Dashboard" },
  { href: "/condominios", label: "Condomínios" },
  { href: "/cadastros", label: "Cadastros" },
];

function AppLayoutComponent({ pageTitle, children }: AppLayoutProps) {
  const pathname = usePathname();
  const router = useRouter();
  const { condominioAtivo } = useCondominio();
  const { session, logout } = useSessionCtx();

  const handleLogout = async () => {
    await logout();
    router.push("/login");
  };

  const isGlobalAdmin = session?.claims?.super_admin === true;

  return (
    <div className="flex min-h-screen bg-background text-foreground">
      {/* Sidebar */}
      <aside className="w-64 bg-[#121826] text-white flex flex-col">
        <div className="p-4 border-b border-white/10">
          <div className="font-bold text-lg">TreeCondo</div>
          {condominioAtivo && (
            <div className="text-xs text-white/70 mt-1">
              Condomínio: {condominioAtivo.nome}
            </div>
          )}
        </div>

        <nav className="flex-1 p-2 space-y-1">
          {menuItems.map((item) => (
            <Link key={item.href} href={item.href}>
              <span
                className={cn(
                  "block rounded-md px-3 py-2 text-sm cursor-pointer",
                  pathname === item.href
                    ? "bg-white text-[#121826] font-semibold"
                    : "text-white/80 hover:bg-white/10"
                )}
              >
                {item.label}
              </span>
            </Link>
          ))}

          {isGlobalAdmin && (
            <Link href="/admin">
              <span
                className={cn(
                  "mt-4 block rounded-md px-3 py-2 text-sm cursor-pointer",
                  pathname.startsWith("/admin")
                    ? "bg-amber-300 text-[#121826] font-semibold"
                    : "text-amber-300 hover:bg-amber-300/10"
                )}
              >
                Administrador Global
              </span>
            </Link>
          )}
        </nav>

        {/* Rodapé / usuário + sair */}
        <div className="p-4 border-t border-white/10 text-xs text-white/70">
          <div className="mb-2">
            {session?.user?.email ?? "Usuário desconhecido"}
          </div>
          <Button
            variant="outline"
            size="sm"
            className="w-full border-white/40 text-white hover:bg-white/10"
            onClick={handleLogout}
          >
            Sair
          </Button>
        </div>
      </aside>

      {/* Conteúdo principal */}
      <main className="flex-1 bg-[#f7f3ef]">
        <header className="px-8 py-6 border-b border-border bg-background/60 backdrop-blur">
          {pageTitle && (
            <h1 className="text-2xl font-semibold tracking-tight">
              {pageTitle}
            </h1>
          )}
        </header>

        <section className="p-8">{children}</section>
      </main>
    </div>
  );
}

export default AppLayoutComponent;
