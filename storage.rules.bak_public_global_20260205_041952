rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() {
      return request.auth != null;
    }

    // Ajuste conforme seu padrão real de claim:
    function isSuper() {
      return signedIn() && (
        request.auth.token.super_admin == true ||
        request.auth.token.superAdmin == true
      );
    }

    // ✅ Storage Rules NÃO tem variável "database".
    // Use (default) no path do firestore.get
    function membroDoc(condId) {
      return firestore.get(/databases/(default)/documents/condominios/$(condId)/membros/$(request.auth.uid));
    }

    function isMembroAtivo(condId) {
      return signedIn() && membroDoc(condId).data.status.upper() == "ATIVO";
    }

    function isOperador(condId) {
      let role = membroDoc(condId).data.role.upper();
      return isMembroAtivo(condId) && (
        role == "ADMIN" ||
        role == "SINDICO" ||
        role == "ADMIN_CONDOMINIO"
      );
    }

    // ------------------------------------------------------------
    // BRANDING (paths oficiais que você está usando no app)
    // branding/global/logo-menu.jpeg
    match /branding/global/{fileName} {
      // Menu do app: qualquer usuário logado pode ler
      allow read: if signedIn();
      // Escrita: só super (ou se quiser, operador global)
      allow write: if isSuper();
    }

    // branding/{condId}/logo-painel.jpeg
    match /branding/{condId}/{fileName} {
      allow read: if isSuper() || isMembroAtivo(condId);
      allow write: if isSuper() || isOperador(condId);
    }

    // ------------------------------------------------------------
    // DOCUMENTOS (mantendo seu padrão)
    match /condominios/{condId}/documentos/{docId}/{fileName} {
      allow read: if isSuper() || isMembroAtivo(condId);
      allow write: if isSuper() || isOperador(condId);
    }

    // Default deny
    match /{path=**} {
      allow read, write: if false;
    }
  }
}
