rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isSuper() {
      return isSignedIn() && (
        request.auth.token.super_admin == true ||
        request.auth.token.superAdmin == true
      );
    }

    function roleUpper() {
      return isSignedIn() && request.auth.token.role != null
        ? request.auth.token.role.toUpperCase()
        : "";
    }

    function isOperator() {
      // ajuste se quiser incluir ADMIN também
      return isSignedIn() && (
        isSuper() ||
        roleUpper() in ["ADMIN_CONDOMINIO", "ADMIN", "SINDICO"]
      );
    }

    function isMembroAtivo(condId) {
      // Ajuste o caminho conforme seu modelo real de membros
      // aqui estou assumindo: condominios/{condId}/membros/{uid} com campo status == "ATIVO"
      return isSignedIn() &&
        exists(/databases/(default)/documents/condominios/$(condId)/membros/$(request.auth.uid)) &&
        get(/databases/(default)/documents/condominios/$(condId)/membros/$(request.auth.uid)).data.status == "ATIVO";
    }

    // Documentos do condomínio
    match /condominios/{condId}/documentos/{docId}/{fileName} {
      allow read: if isMembroAtivo(condId) || isOperator();
      allow write: if isOperator();
    }

    // default: bloqueia todo resto
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
