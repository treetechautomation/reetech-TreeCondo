import {onCall} from "firebase-functions/v2/https";
import * as admin from "firebase-admin";

const db = admin.firestore();

export const adminCreateMorador = onCall(async (req) => {
  const {
    condominioId,
    uid,
    nome,
    email,
    blocoId,
    unidadeId,
  } = req.data;

  if (!condominioId || !uid || !email) {
    throw new Error("Dados obrigatórios não informados.");
  }

  const membroRef = db
    .collection("condominios")
    .doc(condominioId)
    .collection("membros")
    .doc(uid);

  const now = admin.firestore.FieldValue.serverTimestamp();

  const membroData = {
    uid,
    nome: nome || "",
    email,
    role: "MORADOR",
    status: "ATIVO",
    blocoId: blocoId || null,
    unidadeId: unidadeId || null,

    // 🔥 PERMISSÕES PADRÃO (SaaS)
    menuPermissions: {
      dashboard: true,
      anuncios: true,
      reservas: true,
      incidentes: true,
      documentos: true,
      enquetes: true,
      reunioes: true,
      encomendas: true,
    },

    createdAt: now,
    updatedAt: now,
  };

  await membroRef.set(membroData, {merge: true});

  return {
    success: true,
    message: "Morador criado com permissões completas.",
    path: membroRef.path,
  };
});
