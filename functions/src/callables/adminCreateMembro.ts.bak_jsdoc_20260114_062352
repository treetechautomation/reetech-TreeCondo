import {onCall} from "firebase-functions/v2/https";
import * as admin from "firebase-admin";

const db = admin.firestore();

function defaultMenuPermissions(role: string) {
  const r = (role || "").toUpperCase();

  if (r === "PORTEIRO") {
    return {
      dashboard: true,
      acesso: true,
      encomendas: true,
      incidentes: true,
      anuncios: true,
    };
  }

  if (r === "FUNCIONARIO" || r === "FUNCIONÁRIO") {
    return {
      dashboard: true,
      incidentes: true,
      anuncios: true,
    };
  }

  // MORADOR (default)
  return {
    dashboard: true,
    anuncios: true,
    reservas: true,
    incidentes: true,
    documentos: true,
    enquetes: true,
    reunioes: true,
    encomendas: true,
  };
}

export const adminCreateMembro = onCall(async (req) => {
  const {
    condominioId,
    uid,
    nome,
    email,
    role,
    blocoId,
    unidadeId,
    status,
    menuPermissions,
  } = req.data;

  if (!condominioId || !uid || !email) {
    throw new Error("Dados obrigatórios não informados.");
  }

  const now = admin.firestore.FieldValue.serverTimestamp();
  const finalRole = (role || "MORADOR").toUpperCase();
  const finalStatus = status || "ATIVO";

  const membroRef = db
    .collection("condominios")
    .doc(condominioId)
    .collection("membros")
    .doc(uid);

  const finalMenu =
    menuPermissions && typeof menuPermissions === "object" ?
      menuPermissions :
      defaultMenuPermissions(finalRole);

  const membroData = {
    uid,
    nome: nome || "",
    email,
    role: finalRole,
    status: finalStatus,
    blocoId: blocoId || null,
    unidadeId: unidadeId || null,
    menuPermissions: finalMenu,
    createdAt: now,
    updatedAt: now,
  };

  const vinculoRef = db
    .collection("userCondominios")
    .doc(uid)
    .collection("vinculos")
    .doc(condominioId);

  const vinculoData = {
    uid,
    nome: nome || null,
    email,
    role: finalRole,
    status: finalStatus,
    condominioId,
    blocoId: blocoId || null,
    unidadeId: unidadeId || null,
    ativo: true,
    source: "adminCreateMembro",
    createdAt: now,
    updatedAt: now,
  };

  await db.runTransaction(async (tx) => {
    tx.set(membroRef, membroData, {merge: true});
    tx.set(vinculoRef, vinculoData, {merge: true});
  });

  return {
    success: true,
    message: "Membro criado com vínculo e permissões.",
    membroPath: membroRef.path,
    vinculoPath: vinculoRef.path,
    role: finalRole,
    status: finalStatus,
  };
});
